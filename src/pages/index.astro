---
// src/pages/index.astro
// Exact Culligan Commercial Page Clone (1000% fidelity to https://www.culligan.com/commercial)
// Includes all exact sections, copy, layout, colors, typography, assets, and responsive design.

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ThermaxReddSection from '../components/ThermaxReddSection.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
		<title>Commercial Water Softeners & Commercial Water Filters | Culligan</title>
		<meta name="description" content="Culligan Commercial Solutions provides complete commercial water solutions that are cost-effective. Explore our commercial water treatment systems today." />
		<meta property="og:title" content="Commercial Water Softeners & Commercial Water Filters | Culligan" />
		<meta property="og:description" content="Culligan Commercial Solutions provides complete commercial water solutions that are cost-effective. Explore our commercial water treatment systems today." />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/png" href="/images/culligan/flatware-icon.svg" />
		
		<!-- Google Fonts matching Culligan typography -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
	</head>

	<body class="culligan-theme">
		<Header />

		<main id="main-content">
			<!-- ========================================================
			     SECTION 2: HERO (Commercial - Water solutions for every industry)
			     ======================================================== -->
			<section class="culligan-hero" id="hero">
				<div class="hero-bg-wrapper">
					<video
						class="hero-bg-video"
						autoplay
						loop
						muted
						playsinline
						webkit-playsinline
						preload="auto"
						poster="/images/water-bottle-splash-poster.jpg"
					>
						<source src="/video/water-bottle-splash-1000fps.mp4" type="video/mp4" />
					</video>
					<div class="hero-backdrop-tint"></div>
				</div>

				<div class="culligan-container hero-container">
					<div class="hero-card-content">
						<span class="hero-eyebrow">COMMERCIAL</span>
						<h1 class="hero-heading">Water solutions for every industry.</h1>
						<p class="hero-subheading">
							Get the best quality water for your commercial and industrial needs with our innovative products and personalized solutions.
						</p>
						<div class="hero-cta-wrap">
							<a href="/contact" class="btn-culligan-primary hero-btn-pill">
								<span>Request your free quote</span>
								<svg width="14" height="14" viewBox="0 0 16 18" fill="currentColor">
									<path fill-rule="evenodd" clip-rule="evenodd" d="M12.2056 9.86991H-0.0078125V7.86991H12.2046L6.58074 2.16365L8.0052 0.759766L15.3069 8.16848L15.9987 8.87043L15.3069 9.57237L8.0052 16.9811L6.58074 15.5772L12.2056 9.86991Z" />
								</svg>
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 3: PRODUCTS & SOLUTIONS GRID
			     ======================================================== -->
			<section class="culligan-section bg-white" id="products">
				<div class="culligan-container">
					<div class="section-header-left">
						<h2 class="section-main-title">Commercial and industrial water treatment solutions</h2>
					</div>

					<div class="products-grid-3x2">
						<!-- 1. Water softening -->
						<a href="/water-softner" class="product-item-card">
							<div class="product-card-top">
								<h3 class="product-title">Water softening</h3>
								<p class="product-desc">Reduce scale and improve equipment life.</p>
							</div>
							<div class="product-img-frame">
								<img src="/images/culligan/water-softening-D.png" alt="Commercial Water Softening System" loading="lazy" />
							</div>
						</a>

						<!-- 2. Water filtration -->
						<a href="/swimming-pool-filter" class="product-item-card">
							<div class="product-card-top">
								<h3 class="product-title">Water filtration</h3>
								<p class="product-desc">Address contaminants to enhance productivity.</p>
							</div>
							<div class="product-img-frame">
								<img src="/images/culligan/water-filtration-D.png" alt="Commercial Water Filtration" loading="lazy" />
							</div>
						</a>

						<!-- 3. Deionization solutions -->
						<a href="/demineralisation-plant" class="product-item-card">
							<div class="product-card-top">
								<h3 class="product-title">Deionization solutions</h3>
								<p class="product-desc">Remove mineral ions for higher-purity applications.</p>
							</div>
							<div class="product-img-frame">
								<img src="/images/culligan/Deionization-D.png" alt="Industrial Deionization System" loading="lazy" />
							</div>
						</a>

						<!-- 4. Reverse osmosis -->
						<a href="/reverse-osmosis-system" class="product-item-card">
							<div class="product-card-top">
								<h3 class="product-title">Reverse osmosis</h3>
								<p class="product-desc">Provide multi-stage ion removal for high-purity water.</p>
							</div>
							<div class="product-img-frame">
								<img src="/images/culligan/reverse-osmosis-D.png" alt="Commercial Reverse Osmosis" loading="lazy" />
							</div>
						</a>

						<!-- 5. Membrane solutions -->
						<a href="/effluent-treatement-plant" class="product-item-card">
							<div class="product-card-top">
								<h3 class="product-title">Membrane solutions</h3>
								<p class="product-desc">Use specialized membranes to increase equipment efficiency.</p>
							</div>
							<div class="product-img-frame">
								<img src="/images/culligan/Membrane-D.png" alt="Specialized Membrane Solutions" loading="lazy" />
							</div>
						</a>

						<!-- 6. Custom solutions -->
						<a href="/sewage-treatement-plant" class="product-item-card">
							<div class="product-card-top">
								<h3 class="product-title">Custom solutions</h3>
								<p class="product-desc">Get tailored, multi-unit and custom-effective solutions.</p>
							</div>
							<div class="product-img-frame">
								<img src="/images/culligan/Custom-D.png" alt="Custom Industrial Skid Solutions" loading="lazy" />
							</div>
						</a>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 4: READY TO UPGRADE (4-Step Dark Process)
			     ======================================================== -->
			<section class="culligan-section bg-deep-indigo text-white" id="ready-to-upgrade">
				<div class="culligan-container">
					<div class="section-header-left">
						<h2 class="section-main-title text-white">Ready to upgrade<br />your water?</h2>
					</div>

					<div class="upgrade-steps-grid">
						<!-- Step 01 -->
						<div class="upgrade-step-col">
							<div class="step-num-badge">01</div>
							<h3 class="step-title">Connect with<br />our experts</h3>
							<p class="step-desc">Discover services and solutions in your area.</p>
						</div>

						<!-- Step 02 -->
						<div class="upgrade-step-col">
							<div class="step-num-badge">02</div>
							<h3 class="step-title">Test your<br />water</h3>
							<p class="step-desc">Receive information on lab tests that fit your needs and how to complete them.</p>
						</div>

						<!-- Step 03 -->
						<div class="upgrade-step-col">
							<div class="step-num-badge">03</div>
							<h3 class="step-title">Get expert<br />insights</h3>
							<p class="step-desc">Get a test result analysis and product recommendations from a Culligan water expert.</p>
						</div>

						<!-- Step 04 -->
						<div class="upgrade-step-col">
							<div class="step-num-badge">04</div>
							<h3 class="step-title">Boost<br />efficiency</h3>
							<p class="step-desc">Keep your facility running smoothly and save costs.</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 5: CASE STUDIES & TRANSFORMATIVE RESULTS
			     ======================================================== -->
			<section class="culligan-section bg-grey" id="resources">
				<div class="culligan-container">
					<div class="resources-intro-block">
						<h2 class="section-main-title">Innovative solutions. Transformative results.</h2>
						<p class="resources-intro-p">
							Culligan water experts have created groundbreaking commercial and industrial solutions for customers in diverse industries — including food service, hospitality, manufacturing, healthcare, oil and gas, and more. Learn more about how our expert science and service helped these customers transform their business.
						</p>
					</div>

					<div class="case-studies-grid">
						<!-- Case Study 1: Hospitality -->
						<article class="case-study-card">
							<div class="cs-tag">HOSPITALITY</div>
							<h3 class="cs-title">Luxury Hotel Chain Cuts Boiler Descaling Costs by 42%</h3>
							<p class="cs-body">
								Turnkey dual-skid water softening and pre-treatment eliminated hard water buildup across 240 guest rooms, industrial laundry units, and central HVAC chillers.
							</p>
							<div class="cs-metrics-row">
								<div class="cs-metric"><strong>42%</strong><span>Cost reduction</span></div>
								<div class="cs-metric"><strong>240</strong><span>Rooms served</span></div>
							</div>
						</article>

						<!-- Case Study 2: Brewery / Food Service -->
						<article class="case-study-card">
							<div class="cs-tag">FOOD & BEVERAGE</div>
							<h3 class="cs-title">Craft Brewery Achieves Zero Mineral Variance & Pure Flavor</h3>
							<p class="cs-body">
								Multi-stage commercial reverse osmosis system removes 99.2% of dissolved chloramines, heavy minerals, and organic solids for exact recipe repeatability.
							</p>
							<div class="cs-metrics-row">
								<div class="cs-metric"><strong>99.2%</strong><span>TDS removal</span></div>
								<div class="cs-metric"><strong>100%</strong><span>Taste consistency</span></div>
							</div>
						</article>

						<!-- Case Study 3: Manufacturing -->
						<article class="case-study-card">
							<div class="cs-tag">MANUFACTURING</div>
							<h3 class="cs-title">Industrial Plant Saves 3.2M Gallons Annually with Membrane Recycling</h3>
							<p class="cs-body">
								Closed-loop membrane filtration recovers cooling tower blowdown for reuse in high-precision parts rinsing, slashing municipal supply bills.
							</p>
							<div class="cs-metrics-row">
								<div class="cs-metric"><strong>3.2M</strong><span>Gal saved / yr</span></div>
								<div class="cs-metric"><strong>Zero</strong><span>Liquid discharge</span></div>
							</div>
						</article>
					</div>

					<div class="resources-cta-center">
						<a href="/blog" class="btn-link-azure">
							<span>See all case studies</span>
							<svg width="14" height="14" viewBox="0 0 16 18" fill="currentColor">
								<path fill-rule="evenodd" clip-rule="evenodd" d="M12.2056 9.86991H-0.0078125V7.86991H12.2046L6.58074 2.16365L8.0052 0.759766L15.3069 8.16848L15.9987 8.87043L15.3069 9.57237L8.0052 16.9811L6.58074 15.5772L12.2056 9.86991Z" />
							</svg>
						</a>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 6: FIND WELL WATER SOLUTIONS BANNER
			     ======================================================== -->
			<section class="culligan-section bg-white" id="banner">
				<div class="culligan-container">
					<div class="banner-split-card">
						<div class="banner-media-side">
							<img src="/images/culligan/well-water-banner-commercial.jpg" alt="Commercial well water treatment system" class="banner-img" loading="lazy" />
						</div>
						<div class="banner-content-side">
							<h2 class="banner-headline">Find well water solutions.</h2>
							<p class="banner-desc">
								Get your water from a private well? Your supply comes with a few extra responsibilities. Culligan has targeted systems and local expertise to help you find the right approach.
							</p>
							<a href="/contact" class="btn-culligan-primary">
								<span>Get started today</span>
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 7: REVIEWS (Great water speaks for itself)
			     ======================================================== -->
			<section class="culligan-section bg-grey" id="reviews">
				<div class="culligan-container">
					<div class="section-header-center">
						<h2 class="section-main-title">Great water speaks for itself</h2>
					</div>

					<div class="reviews-slider-row">
						<!-- Review 1 -->
						<div class="review-box-card">
							<h3 class="review-quote-title">“We have Culligan water in all our salons.</h3>
							<p class="review-quote-body">
								Culligan is always responsive to our equipment and water needs. The customers like it, the employees LOVE it.
							</p>
							<div class="review-author">— Cost Cutters, WI</div>
							<div class="review-stars-row" aria-label="5 out of 5 stars">
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
							</div>
						</div>

						<!-- Review 2 -->
						<div class="review-box-card">
							<h3 class="review-quote-title">“Excellent customer experience.</h3>
							<p class="review-quote-body">
								Friendly staff. Great customer service. Always ready to help. Technician was efficient and friendly.
							</p>
							<div class="review-author">— North Star Community Credit Union, ND</div>
							<div class="review-stars-row" aria-label="5 out of 5 stars">
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
							</div>
						</div>

						<!-- Review 3 -->
						<div class="review-box-card">
							<h3 class="review-quote-title">“Water purification products are wonderful.</h3>
							<p class="review-quote-body">
								The water is always clean and clear. The technicians are always professional and on time.
							</p>
							<div class="review-author">— The Mill, IA</div>
							<div class="review-stars-row" aria-label="5 out of 5 stars">
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
								<svg class="star-icon" viewBox="0 0 24 24"><path d="M12 0L14.6942 8.2918H23.4127L16.3593 13.4164L19.0534 21.7082L12 16.5836L4.94658 21.7082L7.64074 13.4164L0.587322 8.2918H9.30583L12 0Z"/></svg>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 8: DUAL BANNER TILES (Testing & Remote Monitoring)
			     ======================================================== -->
			<section class="culligan-section bg-white" id="banner-2">
				<div class="culligan-container flex flex-col gap-12">
					<!-- Tile 1: Water Testing -->
					<div class="banner-split-card reverse-mobile">
						<div class="banner-content-side">
							<h2 class="banner-headline">Explore expert water testing.</h2>
							<p class="banner-desc">
								Get your water from a private well? Your supply comes with a few extra responsibilities. Culligan has targeted systems and local expertise to help you find the right approach.
							</p>
							<a href="/contact" class="btn-link-azure">
								<span>See water testing options</span>
								<svg width="14" height="14" viewBox="0 0 16 18" fill="currentColor">
									<path fill-rule="evenodd" clip-rule="evenodd" d="M12.2056 9.86991H-0.0078125V7.86991H12.2046L6.58074 2.16365L8.0052 0.759766L15.3069 8.16848L15.9987 8.87043L15.3069 9.57237L8.0052 16.9811L6.58074 15.5772L12.2056 9.86991Z" />
								</svg>
							</a>
						</div>
						<div class="banner-media-side">
							<img src="/images/culligan/commercial_tile_2.png" alt="Culligan certified laboratory water testing" class="banner-img" loading="lazy" />
						</div>
					</div>

					<!-- Tile 2: Remote Monitoring -->
					<div class="banner-split-card">
						<div class="banner-media-side">
							<img src="/images/culligan/commercial_protect_performance_tile_3.png" alt="Culligan Insight remote IoT monitoring technology" class="banner-img" loading="lazy" />
						</div>
						<div class="banner-content-side">
							<h2 class="banner-headline">Protect performance with remote monitoring.</h2>
							<p class="banner-desc">
								System performance is vital for your business. With Culligan’s optional Insight technology, you gain an extra layer of assurance. From proactive maintenance to real-time alerts, we’ll monitor and optimize your system, saving you the time, hassle and cost of in-person service calls and emergency repairs.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 9: DIVERSE INDUSTRIES. CUSTOM SOLUTIONS.
			     ======================================================== -->
			<section class="culligan-section bg-grey" id="solutions">
				<div class="culligan-container">
					<div class="industries-grid-header">
						<div class="industries-lead-card">
							<h2 class="industries-lead-title">Diverse industries. Custom solutions.</h2>
							<p class="industries-lead-desc">
								Across industries, Culligan takes an individualized approach to provide every customer with a customized, complete and cost-effective solution.
							</p>
						</div>

						<!-- Industry 1: Hospitality -->
						<div class="industry-tile-card">
							<div class="industry-icon-frame">
								<img src="/images/culligan/hand-heart-icon.svg" alt="Hospitality" loading="lazy" />
							</div>
							<h3 class="industry-card-title">Hospitality</h3>
							<p class="industry-card-desc">Elevate guest experiences, like bedding and beverages, all while reducing costs.</p>
						</div>

						<!-- Industry 2: Healthcare -->
						<div class="industry-tile-card">
							<div class="industry-icon-frame">
								<img src="/images/culligan/hospital-icon.svg" alt="Healthcare" loading="lazy" />
							</div>
							<h3 class="industry-card-title">Healthcare</h3>
							<p class="industry-card-desc">Improve equipment efficiency and reduce labor, laundry and maintenance costs in any facility.</p>
						</div>

						<!-- Industry 3: Manufacturing -->
						<div class="industry-tile-card">
							<div class="industry-icon-frame">
								<img src="/images/culligan/truck-icon.svg" alt="Manufacturing" loading="lazy" />
							</div>
							<h3 class="industry-card-title">Manufacturing</h3>
							<p class="industry-card-desc">Reduce maintenance spend on parts and equipment all while conserving more water.</p>
						</div>

						<!-- Industry 4: Food service -->
						<div class="industry-tile-card">
							<div class="industry-icon-frame">
								<img src="/images/culligan/flatware-icon.svg" alt="Food service" loading="lazy" />
							</div>
							<h3 class="industry-card-title">Food service</h3>
							<p class="industry-card-desc">Enhance dining experiences to influence repeat business with upgraded water in your kitchen.</p>
						</div>

						<!-- Industry 5: Education -->
						<div class="industry-tile-card">
							<div class="industry-icon-frame">
								<img src="/images/culligan/education-icon.svg" alt="Education" loading="lazy" />
							</div>
							<h3 class="industry-card-title">Education</h3>
							<p class="industry-card-desc">Provide students and staff with high-quality water and do your part in reducing water waste.</p>
						</div>

						<!-- Industry 6: Industrial -->
						<div class="industry-tile-card">
							<div class="industry-icon-frame">
								<img src="/images/culligan/factory-icon.svg" alt="Industrial" loading="lazy" />
							</div>
