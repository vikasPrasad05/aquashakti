---
// src/pages/services.astro
// Exact 1000% replica of https://www.culligan.com/support/schedule-a-service
// Water Filter & Water Softener Installation, Repairs & Maintenance Services

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Water Filter & Water Softener Installation and Repairs | Culligan"
			description="Schedule water treatment repairs, maintenance programs, system setup, inspection, and water testing services with Culligan water experts."
			image="/images/culligan/well_water_tile.png"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
	</head>

	<body class="culligan-service-page">
		<Header />

		<main id="main-content">
			<!-- ========================================================
			     HERO SECTION: Commercial - Water solutions for every industry (50% Height)
			     ======================================================== -->
			<section class="services-top-hero" id="hero">
				<div class="hero-bg-wrapper">
					<picture>
						<source media="(max-width: 768px)" srcset="/images/culligan/water-solutions-for-every-industry-mobile.jpg" />
						<img src="/images/culligan/water-solutions-for-every-industry.jpg" alt="Commercial water treatment facility" class="hero-bg-img" loading="eager" />
					</picture>
				</div>

				<div class="culligan-container hero-container">
					<div class="hero-card-content">
						<span class="hero-eyebrow">COMMERCIAL</span>
						<h1 class="hero-heading">Water solutions for every industry.</h1>
						<p class="hero-subheading">
							Get the best quality water for your commercial and industrial needs with our innovative products and personalized solutions.
						</p>
						<div class="hero-cta-wrap">
							<a href="#water-treatment-contact-form" class="hero-btn-pill">
								<span>Request your free quote</span>
								<svg width="14" height="14" viewBox="0 0 16 18" fill="currentColor">
									<path fill-rule="evenodd" clip-rule="evenodd" d="M12.2056 9.86991H-0.0078125V7.86991H12.2046L6.58074 2.16365L8.0052 0.759766L15.3069 8.16848L15.9987 8.87043L15.3069 9.57237L8.0052 16.9811L6.58074 15.5772L12.2056 9.86991Z" />
								</svg>
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 1: HERO & SERVICE SCHEDULING FORM
			     ======================================================== -->
			<section class="service-hero-section" id="water-treatment-hero">
				<div class="culligan-container">
					<!-- Breadcrumb Navigation -->
					<nav class="service-breadcrumbs" aria-label="Breadcrumbs">
						<ol class="breadcrumb-list">
							<li><a href="/" class="breadcrumb-link">Home</a></li>
							<li class="breadcrumb-sep" aria-hidden="true">
								<svg width="8" height="12" viewBox="0 0 7 12" fill="none" stroke="currentColor" stroke-width="1.8">
									<path d="M1 1L6 6L1 11" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</li>
							<li><a href="/contact" class="breadcrumb-link">Support</a></li>
							<li class="breadcrumb-sep" aria-hidden="true">
								<svg width="8" height="12" viewBox="0 0 7 12" fill="none" stroke="currentColor" stroke-width="1.8">
									<path d="M1 1L6 6L1 11" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</li>
							<li class="breadcrumb-current" aria-current="page">Water treatment repairs &amp; services</li>
						</ol>
					</nav>

					<!-- Two Column Layout: Left Info, Right Interactive Form -->
					<div class="service-split-grid">
						<!-- Left Information Column -->
						<div class="service-info-col">
							<span class="service-eyebrow">Water treatment repairs &amp; services</span>
							<h1 class="service-main-title">
								Schedule your service in just a few clicks.
							</h1>
							<div class="service-lead-copy">
								<p>
									Your local Culligan water expert has the knowledge and know-how to service and repair your water treatment system to help you get the best possible water. Some dealers can even service non-Culligan systems. Make sure to ask about our service agreements for the most convenient and reliable service, repair, or maintenance for your water treatment system.
								</p>
							</div>

							<!-- Quick contact pill -->
							<div class="service-quick-contact">
								<span class="contact-prompt">Need immediate emergency support?</span>
								<a href="tel:+918799374555" class="contact-dial-link">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
									</svg>
									<span>Call: +91 8799374555</span>
								</a>
							</div>
						</div>

						<!-- Right Interactive Scheduling Form -->
						<div class="service-form-col" id="water-treatment-contact-form">
							<div class="service-form-card">
								<div class="form-header-wrap">
									<h2 class="form-card-title">Let us know what you need.</h2>
									<p class="form-card-subtitle">Fields marked * are required fields.</p>
								</div>

								<form id="scheduleServiceForm" class="culligan-schedule-form">
									<div class="form-fields-grid">
										<!-- First Name -->
										<div class="form-group col-half">
											<label for="firstName" class="form-label">First Name *</label>
											<input
												type="text"
												id="firstName"
												name="FirstName"
												required
												class="form-input"
												placeholder="John"
											/>
										</div>

										<!-- Last Name -->
										<div class="form-group col-half">
											<label for="lastName" class="form-label">Last Name *</label>
											<input
												type="text"
												id="lastName"
												name="LastName"
												required
												class="form-input"
												placeholder="Doe"
											/>
										</div>

										<!-- Company (optional) -->
										<div class="form-group col-half">
											<label for="company" class="form-label">Company (optional)</label>
											<input
												type="text"
												id="company"
												name="Company"
												class="form-input"
												placeholder="Company Name"
											/>
										</div>

										<!-- Email Address -->
										<div class="form-group col-half">
											<label for="emailAddress" class="form-label">Email Address *</label>
											<input
												type="email"
												id="emailAddress"
												name="EmailAddress"
												required
												class="form-input"
												placeholder="john.doe@company.com"
											/>
										</div>

										<!-- Phone # -->
										<div class="form-group col-half">
											<label for="phoneNumber" class="form-label">Phone # *</label>
											<input
												type="tel"
												id="phoneNumber"
												name="Phone"
												required
												class="form-input"
												placeholder="+91 98765 43210"
											/>
										</div>

										<!-- Zip/Postal Code -->
										<div class="form-group col-half">
											<label for="postalCode" class="form-label">Zip/Postal Code *</label>
											<input
												type="text"
												id="postalCode"
												name="PostalCode"
												required
												class="form-input"
												placeholder="382430"
											/>
										</div>

										<!-- Area of Interest -->
										<div class="form-group col-full">
											<label for="interestSupport" class="form-label">Area of Interest *</label>
											<select id="interestSupport" name="InterestSupport" required class="form-select">
												<option value="" disabled selected>Select One</option>
												<option value="Existing Customer - Service or Delivery">Existing Customer - Service or Delivery</option>
												<option value="Water Testing">Water Testing</option>
												<option value="Water Filtration">Water Filtration</option>
												<option value="Water Softening">Water Softening</option>
												<option value="Water Delivery/Water Coolers">Water Delivery/Water Coolers</option>
												<option value="Bottleless Water Coolers">Bottleless Water Coolers</option>
												<option value="Industrial RO Plant Service & Maintenance">Industrial RO Plant Service &amp; Maintenance</option>
												<option value="Other, Please explain below">Other, Please explain below</option>
											</select>
										</div>

										<!-- Question or Message (optional) -->
										<div class="form-group col-full">
											<label for="userMessage" class="form-label">Enter A Question or Message (optional)</label>
											<textarea
												id="userMessage"
												name="UserMessage"
												rows="3"
												class="form-textarea"
												placeholder="Describe your equipment, symptoms, or maintenance requirements..."
											></textarea>
										</div>
									</div>

									<!-- Submit Action -->
									<div class="form-submit-wrap">
										<button type="submit" class="btn-culligan-primary service-submit-btn" id="submitServiceBtn">
											<span>Submit</span>
											<svg width="14" height="14" viewBox="0 0 16 18" fill="currentColor">
												<path fill-rule="evenodd" clip-rule="evenodd" d="M12.2056 9.86991H-0.0078125V7.86991H12.2046L6.58074 2.16365L8.0052 0.759766L15.3069 8.16848L15.9987 8.87043L15.3069 9.57237L8.0052 16.9811L6.58074 15.5772L12.2056 9.86991Z" />
											</svg>
										</button>
										<p class="form-security-note">🔒 Your information is transmitted directly to local certified water service engineers.</p>
									</div>
								</form>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ========================================================
			     SECTION 2: RELY ON CULLIGAN FOR ALL THINGS WATER (4 STEPS)
			     ======================================================== -->
			<section class="service-steps-section" id="installation-steps">
				<div class="culligan-container">
					<!-- Top Banner Grid: Left Promo Text, Right Well Water Image -->
					<div class="steps-hero-grid">
						<div class="steps-hero-text">
							<h2 class="steps-main-title">
								Rely on Culligan for all things water.
							</h2>
							<p class="steps-sub-title">
								Tap into the leading water treatment experts, located right in your neighborhood.
							</p>
							<div class="steps-cta-wrap">
								<a href="#water-treatment-contact-form" class="btn-culligan-primary steps-schedule-btn">
									<span>Schedule your service</span>
									<svg width="14" height="14" viewBox="0 0 16 18" fill="currentColor">
										<path fill-rule="evenodd" clip-rule="evenodd" d="M12.2056 9.86991H-0.0078125V7.86991H12.2046L6.58074 2.16365L8.0052 0.759766L15.3069 8.16848L15.9987 8.87043L15.3069 9.57237L8.0052 16.9811L6.58074 15.5772L12.2056 9.86991Z" />
									</svg>
								</a>
							</div>
						</div>

						<div class="steps-hero-image-wrap">
							<div class="steps-image-frame">
								<img
									src="/images/culligan/well_water_tile.png"
									alt="Culligan Water Treatment Equipment System"
									class="steps-tile-img"
									width="800"
									height="465"
									loading="lazy"
								/>
							</div>
						</div>
					</div>

					<!-- 4 Step Feature Cards Grid -->
					<div class="steps-cards-grid">
						<!-- Step 01: Repairs -->
						<div class="step-service-card">
							<span class="step-number">01</span>
							<h3 class="step-card-title">Repairs</h3>
							<p class="step-card-desc">
								Reach out for help fixing water softeners, whole home filtration systems, and reverse osmosis filtration systems.
							</p>
						</div>

						<!-- Step 02: Maintenance programs -->
						<div class="step-service-card">
							<span class="step-number">02</span>
							<h3 class="step-card-title">Maintenance programs</h3>
							<p class="step-card-desc">
								Keep systems running smoothly with regular check-ups, including filter changes and salt delivery. Ask about our annual service plans that make maintenance hassle free.
							</p>
						</div>

						<!-- Step 03: System setup & inspection -->
						<div class="step-service-card">
							<span class="step-number">03</span>
							<h3 class="step-card-title">System setup &amp; inspection</h3>
							<p class="step-card-desc">
								Purchased a system? We can install and configure it to your preferences – or inspect a current system that’s already in place.
							</p>
						</div>

						<!-- Step 04: Water Testing -->
						<div class="step-service-card">
							<span class="step-number">04</span>
							<h3 class="step-card-title">Water Testing</h3>
							<p class="step-card-desc">
								We’ll conduct a <a href="#water-treatment-contact-form" class="step-inline-link">free water test</a> to help you find the right treatment solution or ensure your current system is functioning properly.
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<Footer />
		<QuoteModal />

		<script>
			// Schedule Service Form Submission Handler
			const form = document.getElementById('scheduleServiceForm') as HTMLFormElement | null;
			if (form) {
				form.addEventListener('submit', (e) => {
					e.preventDefault();
					const firstInput = document.getElementById('firstName') as HTMLInputElement;
					const lastInput = document.getElementById('lastName') as HTMLInputElement;
					const phoneInput = document.getElementById('phoneNumber') as HTMLInputElement;
					const emailInput = document.getElementById('emailAddress') as HTMLInputElement;
					const companyInput = document.getElementById('company') as HTMLInputElement;
					const zipInput = document.getElementById('postalCode') as HTMLInputElement;
					const interestSelect = document.getElementById('interestSupport') as HTMLSelectElement;
					const msgInput = document.getElementById('userMessage') as HTMLTextAreaElement;

					const firstName = firstInput?.value.trim() || '';
					const lastName = lastInput?.value.trim() || '';
					const phone = phoneInput?.value.trim() || '';
					const email = emailInput?.value.trim() || '';
					const company = companyInput?.value.trim() || 'N/A';
					const zip = zipInput?.value.trim() || '';
					const interest = interestSelect?.value || 'General Service';
					const msg = msgInput?.value.trim() || 'Service request submitted from Schedule a Service page.';

					// Format WhatsApp message to engineering service desk
					const waText = `Hello AquaShakti / Culligan Service Team,\n\nI want to schedule a service:\n\n*Name:* ${firstName} ${lastName}\n*Phone:* ${phone}\n*Email:* ${email}\n*Company:* ${company}\n*Postal Code:* ${zip}\n*Service Type:* ${interest}\n*Message:* ${msg}`;
					const waUrl = `https://api.whatsapp.com/send?phone=918799374555&text=${encodeURIComponent(waText)}`;

					window.open(waUrl, '_blank');
					alert(`Thank you, ${firstName}! Your service request has been scheduled. A certified field technician will contact you shortly.`);
					form.reset();
				});
			}
		</script>

		<style>
			/* ========================================================
			   CULLIGAN SCHEDULE A SERVICE STYLES
			   Exact 1000% replication of culligan.com/support/schedule-a-service
			   ======================================================== */

			:root {
				--azure-blue: #0066cc;
				--azure-blue-hover: #0052a3;
				--deep-indigo: #0f172a;
				--grey-light: #f8fafc;
				--grey-medium: #e2e8f0;
				--grey-border: #cbd5e1;
				--text-dark: #1e293b;
				--text-muted: #64748b;
				--font-manrope: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
			}

			body.culligan-service-page {
				font-family: var(--font-manrope);
				color: var(--text-dark);
				background-color: #ffffff;
				margin: 0;
				padding: 0;
			}

			main#main-content {
				padding-top: 0 !important;
				margin-top: 0 !important;
			}

			.culligan-container {
				width: 100%;
				max-width: 1240px;
				margin: 0 auto;
				padding: 0 1.5rem;
				box-sizing: border-box;
			}

			/* ========================================================
			   TOP HERO SECTION (Commercial Water Solutions - 50% Height)
			   ======================================================== */
			.services-top-hero {
				position: relative;
				height: 50vh;
				min-height: 50vh;
				display: flex;
				align-items: center;
				background: #001f35;
				overflow: hidden;
			}

			.services-top-hero::before {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(
					90deg,
					rgba(0, 31, 53, 0.75) 0%,
					rgba(0, 31, 53, 0.45) 50%,
					rgba(0, 31, 53, 0.20) 100%
				);
				z-index: 1;
				pointer-events: none;
			}

			.services-top-hero .hero-bg-wrapper {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				z-index: 0;
			}

			.services-top-hero .hero-bg-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: right center;
				opacity: 0.65;
				filter: brightness(0.92);
				transform: none;
			}

			.services-top-hero .hero-container {
				position: relative;
				z-index: 10;
				width: 100%;
				padding-top: 2rem;
				padding-bottom: 2rem;
			}

			.services-top-hero .hero-card-content {
				max-width: 580px;
			}

			.services-top-hero .hero-eyebrow {
				display: inline-block;
				font-family: var(--font-manrope);
				font-size: 0.8rem;
				font-weight: 800;
				letter-spacing: 0.1em;
				color: #38bdf8;
				margin-bottom: 0.5rem;
				text-transform: uppercase;
				text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
			}

			.services-top-hero .hero-heading {
				font-family: var(--font-manrope);
				font-size: clamp(1.8rem, 3.2vw, 2.5rem);
				font-weight: 700;
				line-height: 1.15;
				letter-spacing: -0.03em;
				color: #ffffff;
				margin-bottom: 0.75rem;
				text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
			}

			.services-top-hero .hero-subheading {
				font-size: 0.95rem;
				line-height: 1.5;
				color: rgba(255, 255, 255, 0.95);
				margin-bottom: 1.25rem;
				text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
			}

			.services-top-hero .hero-cta-wrap {
				display: flex;
				align-items: center;
			}

			.services-top-hero .hero-btn-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.65rem;
				background-color: var(--azure-blue, #0066cc);
				color: #ffffff;
				font-weight: 700;
				font-size: 0.95rem;
				padding: 0.7rem 1.6rem;
				border-radius: 9999px;
				text-decoration: none;
				transition: all 0.25s ease;
				box-shadow: 0 4px 14px rgba(0, 102, 204, 0.35);
			}

			.services-top-hero .hero-btn-pill:hover {
				background-color: var(--azure-blue-hover, #0052a3);
				color: #ffffff;
				transform: translateY(-2px);
				box-shadow: 0 6px 20px rgba(0, 102, 204, 0.5);
			}

			@media (max-width: 768px) {
				.services-top-hero {
					height: auto;
					min-height: 50vh;
					padding: 2.5rem 0;
				}
				.services-top-hero .hero-card-content {
					padding: 0;
					background: transparent;
				}
			}

			/* ========================================================
			   BREADCRUMBS
			   ======================================================== */
			.service-breadcrumbs {
				padding-top: 1.5rem;
				padding-bottom: 1.5rem;
			}

			.breadcrumb-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 0.8rem;
				font-weight: 500;
			}

			.breadcrumb-link {
				color: var(--deep-indigo);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.breadcrumb-link:hover {
				color: var(--azure-blue);
				text-decoration: underline;
			}

			.breadcrumb-sep {
				display: flex;
				align-items: center;
				color: #94a3b8;
			}

			.breadcrumb-current {
				color: #64748b;
				font-weight: 400;
			}

			/* ========================================================
			   HERO & FORM SECTION (Two Columns)
			   ======================================================== */
			.service-hero-section {
				padding-bottom: 5rem;
				background-color: #ffffff;
			}

			.service-split-grid {
				display: grid;
				grid-template-columns: 5fr 7fr;
				gap: 3.5rem;
				align-items: flex-start;
			}

			/* Left Info Column */
			.service-info-col {
				padding-top: 1rem;
			}

			.service-eyebrow {
				display: block;
				font-size: 1.15rem;
				font-weight: 600;
				color: var(--deep-indigo);
				margin-bottom: 0.75rem;
			}

			.service-main-title {
				font-size: clamp(2rem, 3.2vw, 2.85rem);
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -0.025em;
				color: var(--deep-indigo);
				margin: 0 0 1.5rem 0;
			}

			.service-lead-copy p {
				font-size: 1.05rem;
				line-height: 1.65;
				color: var(--deep-indigo);
				margin: 0 0 2rem 0;
			}

			.service-quick-contact {
				background: #f1f5f9;
				border: 1px solid var(--grey-medium);
				border-radius: 10px;
				padding: 1.25rem 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.contact-prompt {
				font-size: 0.88rem;
				color: var(--text-muted);
				font-weight: 500;
			}

			.contact-dial-link {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--azure-blue);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.contact-dial-link:hover {
				color: var(--azure-blue-hover);
				text-decoration: underline;
			}

			/* Right Form Column */
			.service-form-card {
