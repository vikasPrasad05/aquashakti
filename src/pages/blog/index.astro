			/* Pagination Bar (Exact Xylem) */
			.pagination {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--xylem-border-subtle);
				flex-wrap: wrap;
				gap: 1rem;
			}

			.pagination .items-info {
				font-size: 0.875rem;
				color: var(--xylem-text-muted);
			}

			.pagination-controls ul {
				display: flex;
				list-style: none;
				margin: 0;
				padding: 0;
				gap: 4px;
			}

			.pagination-controls .page-number a {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 36px;
				height: 36px;
				border-radius: 4px;
				border: 1px solid var(--xylem-border);
				color: var(--xylem-text-heading);
				text-decoration: none;
				font-size: 0.875rem;
				font-weight: 600;
				transition: all 0.2s;
			}

			.pagination-controls .page-number.active a {
				background-color: var(--xylem-dark);
				color: #ffffff;
				border-color: var(--xylem-dark);
			}

			.pagination-controls .page-number a:hover:not(.active) {
				border-color: var(--xylem-teal);
				color: var(--xylem-teal);
			}

			.items-per-page {
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.page-size-label {
				font-size: 0.875rem;
				color: var(--xylem-text-muted);
			}
		</style>

		<!-- Client-Side Filter, Search, Sort & Toggle Logic -->
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const tileItems = Array.from(document.querySelectorAll('.atlas-tile-item'));
				const searchInput = document.getElementById('xylemSearchInput');
				const clearSearchBtn = document.getElementById('clearSearchInputBtn');
				const toggleFiltersBtn = document.getElementById('toggleFiltersBtn');
				const mainGridLayout = document.getElementById('mainGridLayout');
				const filterCheckboxes = document.querySelectorAll('.facet-checkbox');
				const clearAllBtn = document.getElementById('clearAllBtn');
				const pillContainer = document.getElementById('pillContainer');
				const mainTagPill = document.getElementById('mainTagPill');
				const displayedCountEl = document.getElementById('displayedCount');
				const noResultsState = document.getElementById('noResultsState');
				const emptyResetBtn = document.getElementById('emptyResetBtn');

				// Sort elements
				const sortTriggerBtn = document.getElementById('sortTriggerBtn');
				const sortDropdownMenu = document.getElementById('sortDropdownMenu');
				const sortCurrentLabel = document.getElementById('sortCurrentLabel');
				const sortOptions = document.querySelectorAll('.sort-option-btn');

				// Accordion groups
				const accordionHeaders = document.querySelectorAll('.group-header-btn');

				// Page size
				const pageSizeBtn = document.getElementById('pageSizeBtn');
				const pageSizeMenu = document.getElementById('pageSizeMenu');
				const pageSizeLabel = document.getElementById('pageSizeLabel');
				const pageSizeOptions = document.querySelectorAll('.pagesize-option');

				let currentSort = 'relevance';
				let isMainTagActive = true;

				// 1. Accordion Toggles
				accordionHeaders.forEach(header => {
					header.addEventListener('click', () => {
						const group = header.closest('.dropdown-filter-group');
						const isOpen = group.classList.contains('open');
						group.classList.toggle('open');
						header.setAttribute('aria-expanded', !isOpen);
					});
				});

				// 2. Toggle Left Filter Sidebar
				toggleFiltersBtn?.addEventListener('click', () => {
					if (window.innerWidth <= 992) {
						const isOpen = mainGridLayout.classList.toggle('mobile-filters-open');
						toggleFiltersBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
					} else {
						const isCollapsed = mainGridLayout.classList.toggle('filters-collapsed');
						toggleFiltersBtn.setAttribute('aria-expanded', !isCollapsed);
					}
				});

				// 3. Sort Dropdown Toggle & Selection
				sortTriggerBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					const isHidden = sortDropdownMenu.style.display === 'none';
					sortDropdownMenu.style.display = isHidden ? 'block' : 'none';
					sortTriggerBtn.setAttribute('aria-expanded', isHidden);
				});

				document.addEventListener('click', () => {
					if (sortDropdownMenu) sortDropdownMenu.style.display = 'none';
					if (pageSizeMenu) pageSizeMenu.style.display = 'none';
				});

				sortOptions.forEach(opt => {
					opt.addEventListener('click', () => {
						sortOptions.forEach(o => o.classList.remove('active'));
						opt.classList.add('active');
						currentSort = opt.getAttribute('data-sort');
						sortCurrentLabel.textContent = `Sort by: ${opt.textContent}`;
						sortDropdownMenu.style.display = 'none';
						applyFiltersAndSort();
					});
				});

				// 4. Page Size Dropdown Toggle & Selection
				pageSizeBtn?.addEventListener('click', (e) => {
					e.stopPropagation();
					const isHidden = pageSizeMenu.style.display === 'none';
					pageSizeMenu.style.display = isHidden ? 'block' : 'none';
				});

				pageSizeOptions.forEach(opt => {
					opt.addEventListener('click', () => {
						pageSizeOptions.forEach(o => o.classList.remove('active'));
						opt.classList.add('active');
						pageSizeLabel.textContent = opt.textContent;
						pageSizeMenu.style.display = 'none';
					});
				});

				// 5. Search Input Handlers
				searchInput?.addEventListener('input', () => {
					if (clearSearchBtn) {
						clearSearchBtn.style.display = searchInput.value ? 'block' : 'none';
					}
					applyFiltersAndSort();
				});

				clearSearchBtn?.addEventListener('click', () => {
					searchInput.value = '';
					clearSearchBtn.style.display = 'none';
					applyFiltersAndSort();
				});

				// 6. Checkbox changes
				filterCheckboxes.forEach(cb => {
					cb.addEventListener('change', () => {
						updateFilterPills();
						applyFiltersAndSort();
					});
				});

				// 7. Main tag pill remove
				mainTagPill?.querySelector('.pill-remove-btn')?.addEventListener('click', () => {
					isMainTagActive = false;
					mainTagPill.style.display = 'none';
					applyFiltersAndSort();
				});

				// 8. Clear all filters
				clearAllBtn?.addEventListener('click', resetAllFilters);
				emptyResetBtn?.addEventListener('click', resetAllFilters);

				function resetAllFilters() {
					if (searchInput) searchInput.value = '';
					if (clearSearchBtn) clearSearchBtn.style.display = 'none';
					filterCheckboxes.forEach(cb => cb.checked = false);
					isMainTagActive = true;
					if (mainTagPill) mainTagPill.style.display = 'inline-flex';
					updateFilterPills();
					applyFiltersAndSort();
				}

				// Update dynamic filter pills based on checked checkboxes
				function updateFilterPills() {
					// Remove any dynamic pills
					const dynamicPills = pillContainer.querySelectorAll('.dynamic-pill');
					dynamicPills.forEach(p => p.remove());

					filterCheckboxes.forEach(cb => {
						if (cb.checked) {
							const val = cb.getAttribute('data-value');
							const pill = document.createElement('div');
							pill.className = 'active-facet-pill dynamic-pill';
							pill.innerHTML = `<span>${val}</span><button type="button" class="pill-remove-btn" title="Remove filter">✕</button>`;
							pill.querySelector('.pill-remove-btn').addEventListener('click', () => {
								cb.checked = false;
								pill.remove();
								applyFiltersAndSort();
							});
							pillContainer.appendChild(pill);
						}
					});
				}

				// Master Filter & Sort function
				function applyFiltersAndSort() {
					const query = (searchInput?.value || '').trim().toLowerCase();
					
					// Gather active checkbox filters by group
					const activeFilters = {
						market: [],
						applications: [],
						blog: [],
						topics: [],
						category: []
					};

					filterCheckboxes.forEach(cb => {
						if (cb.checked) {
							const grp = cb.getAttribute('data-group');
							const val = cb.getAttribute('data-value');
							if (activeFilters[grp]) activeFilters[grp].push(val);
						}
					});

					let visibleCount = 0;
					const visibleTiles = [];

					tileItems.forEach(item => {
						const title = item.getAttribute('data-title') || '';
						const desc = item.getAttribute('data-desc') || '';
						const markets = JSON.parse(item.getAttribute('data-markets') || '[]');
						const applications = JSON.parse(item.getAttribute('data-applications') || '[]');
						const topics = JSON.parse(item.getAttribute('data-topics') || '[]');
						const blog = item.getAttribute('data-blog') || '';
						const category = item.getAttribute('data-category') || '';

						// 1. Text search match
						let matchesQuery = true;
						if (query) {
							matchesQuery = title.includes(query) || desc.includes(query);
						}

						// 2. Facet filters match (ANY within category must match if category has selected items)
						let matchesMarket = true;
						if (activeFilters.market.length > 0) {
							matchesMarket = activeFilters.market.some(m => markets.includes(m));
						}

						let matchesApps = true;
						if (activeFilters.applications.length > 0) {
							matchesApps = activeFilters.applications.some(a => applications.includes(a));
						}

						let matchesTopics = true;
						if (activeFilters.topics.length > 0) {
							matchesTopics = activeFilters.topics.some(t => topics.includes(t));
						}

						let matchesBlog = true;
						if (activeFilters.blog.length > 0) {
							matchesBlog = activeFilters.blog.includes(blog);
						}

						let matchesCategory = true;
						if (activeFilters.category.length > 0) {
							matchesCategory = activeFilters.category.includes(category);
						}

						const isVisible = matchesQuery && matchesMarket && matchesApps && matchesTopics && matchesBlog && matchesCategory;

						if (isVisible) {
							item.style.display = 'block';
							visibleCount++;
							visibleTiles.push(item);
						} else {
							item.style.display = 'none';
						}
					});

					// Update counts
					if (displayedCountEl) displayedCountEl.textContent = visibleCount;
					if (noResultsState) {
						noResultsState.style.display = visibleCount === 0 ? 'block' : 'none';
					}

					// Apply Sorting to visible items
					if (visibleCount > 1) {
						const list = document.getElementById('atlasTileList');
						if (currentSort === 'az') {
							visibleTiles.sort((a, b) => {
								const tA = (a.getAttribute('data-title') || '').trim();
								const tB = (b.getAttribute('data-title') || '').trim();
								return tA.localeCompare(tB);
							});
							visibleTiles.forEach(tile => list.appendChild(tile));
						} else if (currentSort === 'za') {
							visibleTiles.sort((a, b) => {
								const tA = (a.getAttribute('data-title') || '').trim();
								const tB = (b.getAttribute('data-title') || '').trim();
								return tB.localeCompare(tA);
							});
							visibleTiles.forEach(tile => list.appendChild(tile));
						} else {
							// Default / Relevance: sort by data-id
							visibleTiles.sort((a, b) => {
								const idA = parseInt(a.getAttribute('data-id') || '0', 10);
								const idB = parseInt(b.getAttribute('data-id') || '0', 10);
								return idA - idB;
							});
							visibleTiles.forEach(tile => list.appendChild(tile));
						}
					}
				}
			});
		</script>
