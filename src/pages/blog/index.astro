			/* Sidebar Filter Groups - Sticky so it never scrolls up and out of view */
			.search--filters--container {
				background-color: #ffffff;
				border: 1px solid var(--xylem-border);
				border-radius: 4px;
				padding: 0;
				align-self: start;
				position: -webkit-sticky;
				position: sticky;
				top: 136px;
				max-height: calc(100vh - 150px);
				overflow-y: auto;
				overscroll-behavior: contain;
