---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
import { COMPANY_NAME, COMPANY_PHONE, COMPANY_EMAIL, COMPANY_LOCATION } from '../consts';
---

<!doctype html>
<html lang="en-us" data-culture="en-US">
	<head>
		<BaseHead
			title="Contact Us | Aqua Shakti Industries"
			description="Whether you would like additional information or are interested in getting a quote for industrial water treatment plants, we're here to help."
			image="/images/hero-plant.jpg"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="xylem-contact-body">
		<Header />

		<main class="contact-page-main">
			<div class="content-page-with-sidebar-wrapper content-detail-wrapper" xyl-view="contentDetailPage">
				<div class="wrapper">
					<!-- Page Title -->
					<div class="title-container">
						<h1 class="page-title">Contact Us</h1>
					</div>

					<div class="pure-g">
						<!-- Main Detail Content Area (17/24 width on desktop) -->
						<div class="detail-content body-copy main-content-area pure-u-1 pure-u-lg-17-24">
							<div class="pure-u flex-equal-height clear-all">
								<div class="component-formBlock component-default iconHeading">
									<div class="embed-code pure-u-1 marketoForm">
										<div class="description-wrapper prose">
											<p>
												Whether you would like additional information or are interested in getting a
												quote, we're here to help.
											</p>
										</div>

										<div class="content form-wrapper pl-1 py-1" data-embedform-id="18578" xyl-view="marketoForm">
											<p class="all-req-msg">All fields required.</p>

											<h3 class="hidden offline-message" id="offline-message" style="display: none;">
												Looks like you are offline, your form will be sent as soon as you get back online.
											</h3>

											<!-- Marketo-Styled Form -->
											<form id="xylem-rfq-form" class="mktoForm" onsubmit="event.preventDefault(); submitXylemForm();" novalidate>
												<!-- Row 1: First Name & Last Name -->
												<div class="mktoFormRow">
													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="FirstName" class="mktoLabel">First Name</label>
															<input
																type="text"
																id="FirstName"
																name="FirstName"
																class="mktoField"
																required
																autocomplete="given-name"
															/>
															<div class="field-error-msg" id="err-FirstName">This field is required.</div>
														</div>
													</div>

													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="LastName" class="mktoLabel">Last Name</label>
															<input
																type="text"
																id="LastName"
																name="LastName"
																class="mktoField"
																required
																autocomplete="family-name"
															/>
															<div class="field-error-msg" id="err-LastName">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Row 2: Business Email & Company -->
												<div class="mktoFormRow">
													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Email" class="mktoLabel">Business Email</label>
															<input
																type="email"
																id="Email"
																name="Email"
																class="mktoField"
																required
																autocomplete="email"
															/>
															<div class="field-error-msg" id="err-Email">Please enter a valid business email.</div>
														</div>
													</div>

													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Company" class="mktoLabel">Company</label>
															<input
																type="text"
																id="Company"
																name="Company"
																class="mktoField"
																required
																autocomplete="organization"
															/>
															<div class="field-error-msg" id="err-Company">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Row 3: Phone & Industry -->
												<div class="mktoFormRow">
													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Phone" class="mktoLabel">Phone</label>
															<input
																type="tel"
																id="Phone"
																name="Phone"
																class="mktoField"
																required
																autocomplete="tel"
															/>
															<div class="field-error-msg" id="err-Phone">This field is required.</div>
														</div>
													</div>

													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Industry" class="mktoLabel">Industry:</label>
															<select id="Industry" name="Industry" class="mktoField" required>
																<option value="" selected>Select...</option>
																<option value="Chemicals & Pharmaceuticals">Chemicals &amp; Pharmaceuticals</option>
																<option value="Textiles & Dyeing">Textiles &amp; Dyeing</option>
																<option value="Food & Beverage">Food &amp; Beverage</option>
																<option value="Commercial Buildings / Hospitals / Hotels">Commercial Buildings / Hospitals / Hotels</option>
																<option value="Manufacturing & Engineering">Manufacturing &amp; Engineering</option>
																<option value="Agriculture & Irrigation">Agriculture &amp; Irrigation</option>
																<option value="Power Generation">Energy &amp; Power</option>
																<option value="Municipal Water & Wastewater">Municipal Water &amp; Wastewater</option>
																<option value="Metals & Mining">Metals &amp; Mining</option>
																<option value="Water Treatment & Chemicals">Water Treatment Plants &amp; Chemicals</option>
																<option value="Other">Other</option>
															</select>
															<div class="field-error-msg" id="err-Industry">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Row 4: Select Your Location & State Name -->
												<div class="mktoFormRow">
													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="countryName" class="mktoLabel">Select Your Location</label>
															<select id="countryName" name="countryName" class="mktoField" required onchange="handleCountryChange(this.value)">
																<option value="">Please Select</option>
																<option value="India" selected>India</option>
																<option value="United States">United States</option>
																<option value="United Arab Emirates">United Arab Emirates</option>
																<option value="Saudi Arabia">Saudi Arabia</option>
																<option value="Canada">Canada</option>
																<option value="United Kingdom">United Kingdom</option>
																<option value="Australia">Australia</option>
																<option value="Singapore">Singapore</option>
																<option value="Other">Other Country</option>
															</select>
															<div class="field-error-msg" id="err-countryName">This field is required.</div>
														</div>
													</div>

													<div class="mktoFormCol" id="stateCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="stateName" class="mktoLabel" id="lblStateName">State Name</label>
															<select id="stateName" name="stateName" class="mktoField" required>
																<option value="">Select...</option>
															</select>
															<div class="field-error-msg" id="err-stateName">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Row 5: City & Address -->
												<div class="mktoFormRow">
													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="City" class="mktoLabel">City</label>
															<input
																type="text"
																id="City"
																name="City"
																class="mktoField"
																required
																autocomplete="address-level2"
															/>
															<div class="field-error-msg" id="err-City">This field is required.</div>
														</div>
													</div>

													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Address" class="mktoLabel">Address</label>
															<input
																type="text"
																id="Address"
																name="Address"
																class="mktoField"
																required
																autocomplete="street-address"
															/>
															<div class="field-error-msg" id="err-Address">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Row 6: Plant Requirement & Postal Code -->
												<div class="mktoFormRow">
													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Xylem_Brand" class="mktoLabel">Plant Requirement</label>
															<select id="Xylem_Brand" name="Xylem_Brand" class="mktoField" required>
																<option value="">Please Select</option>
																<option value="Industrial RO Plant">Industrial RO Plant (500 – 50,000+ LPH)</option>
																<option value="Commercial RO Plant">Commercial RO Plant (25 – 1,000 LPH)</option>
																<option value="Effluent Treatment Plant (ETP)">Effluent Treatment Plant (ETP)</option>
																<option value="Sewage Treatment Plant (STP)">Sewage Treatment Plant (STP)</option>
																<option value="Industrial Water Softener Plant">Industrial Water Softener Plant</option>
																<option value="Demineralization (DM) / Mix Bed Plant">Demineralization (DM) / Mix Bed Plant</option>
																<option value="Ozonation & Packaged Water Plant">Ozonation &amp; Packaged Drinking Water</option>
																<option value="Rain Water Harvesting System">Rain Water Harvesting System</option>
																<option value="Swimming Pool Filtration System">Swimming Pool Filtration System</option>
																<option value="Membranes, Resins, Antiscalants & Spares">Membranes, Resins, Antiscalants &amp; Spares</option>
																<option value="Other Water Treatment System">Other Water Treatment System</option>
															</select>
															<div class="field-error-msg" id="err-Xylem_Brand">This field is required.</div>
														</div>
													</div>

													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="PostalCode" class="mktoLabel">Postal Code</label>
															<input
																type="text"
																id="PostalCode"
																name="PostalCode"
																class="mktoField"
																required
																autocomplete="postal-code"
															/>
															<div class="field-error-msg" id="err-PostalCode">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Row 7: Job Title & How can we help you? -->
												<div class="mktoFormRow">
													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Title" class="mktoLabel">Job Title:</label>
															<input
																type="text"
																id="Title"
																name="Title"
																class="mktoField"
																required
																autocomplete="organization-title"
															/>
															<div class="field-error-msg" id="err-Title">This field is required.</div>
														</div>
													</div>

													<div class="mktoFormCol">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Request_Type__c" class="mktoLabel">How can we help you?</label>
															<select id="Request_Type__c" name="Request_Type__c" class="mktoField" required>
																<option value="">Please Select</option>
																<option value="Request Sizing & Quotation">Request Sizing &amp; Quotation</option>
																<option value="Buy New Plant">Buy New Plant</option>
																<option value="Water Test & Technical Analysis">Water Test &amp; Technical Analysis</option>
																<option value="Aftermarket, Spares & AMC">Aftermarket, Spares &amp; AMC</option>
																<option value="Customer Support">Customer Support</option>
																<option value="Other">Other</option>
															</select>
															<div class="field-error-msg" id="err-Request_Type__c">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Row 8: Upcoming Project -->
												<div class="mktoFormRow">
													<div class="mktoFormCol mktoColFull">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="americasUpcomingProject" class="mktoLabel">I have an upcoming project</label>
															<select id="americasUpcomingProject" name="americasUpcomingProject" class="mktoField" required>
																<option value="">Select...</option>
																<option value="Yes">Yes</option>
																<option value="No">No</option>
															</select>
															<div class="field-error-msg" id="err-americasUpcomingProject">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Row 9: What are your project or support needs? -->
												<div class="mktoFormRow">
													<div class="mktoFormCol mktoColFull">
														<div class="mktoFieldWrap mktoRequiredField">
															<label for="Xylem_Lead_Question" class="mktoLabel">What are your project or support needs?</label>
															<textarea
																id="Xylem_Lead_Question"
																name="Xylem_Lead_Question"
																class="mktoField mktoTextarea"
																required
																rows="4"
																placeholder="Mention required capacity (e.g. 5,000 LPH), raw water source (borewell, river, effluent), TDS or any specific requirements..."
															></textarea>
															<div class="field-error-msg" id="err-Xylem_Lead_Question">This field is required.</div>
														</div>
													</div>
												</div>

												<!-- Required Field Note -->
												<div class="req-field-msg wide">
													<span>*</span> Required Field
												</div>

												<!-- Opt-in Checkbox -->
												<div class="mktoCheckboxWrap">
													<input type="checkbox" id="GDPR_Consent__c" name="GDPR_Consent__c" />
													<label for="GDPR_Consent__c">
														Yes, I'd like to receive periodic technical updates and product offers from Aqua Shakti Industries
													</label>
												</div>

												<!-- Privacy Statement -->
												<div class="mktoPrivacyText">
													By submitting this form, you confirm that you agree to the storing and processing of your personal data as described in our <a href="/privacy">Privacy Policy</a>.
												</div>

												<!-- Submit Button Row -->
												<div class="mktoButtonRow">
													<button type="submit" id="mktoSubmitBtn" class="mktoButton">
														Submit
													</button>
												</div>
											</form>

											<!-- Thank You Confirmation Screen -->
											<div id="thank-you-view" class="thank-you-container" style="display: none;">
												<div class="thank-you-icon-circle">
													<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
														<polyline points="20 6 9 17 4 12"></polyline>
													</svg>
												</div>
												<h2 class="thank-you-title">Thank you for contacting us!</h2>
												<p class="thank-you-desc">
													Whether you would like additional information or are interested in getting a quote, we're here to help. Your submission has been received and our engineering support team will review your inquiry and follow up shortly.
												</p>

												<div class="thank-you-actions-card">
													<a id="thank-you-wa-btn" href="#" target="_blank" class="mktoButton wa-action-btn">
														Connect on WhatsApp Now &rarr;
													</a>
													<button type="button" class="btn-sub-reset" onclick="resetFormToStart()">
														Send another message
													</button>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Sidebar (7/24 width on desktop) - Clean Aqua Shakti Head Office & Consultation -->
						<div class="sidebar pure-u-1 pure-u-lg-7-24 mb-1" data-accordion-breakpoint="desktopLarge" xyl-view="accordion">
							<!-- 1. Aqua Shakti Works & Head Office -->
							<div class="component-freeTextBlock component-default" xyl-view="freeTextBlock">
								<div class="accordion-item" data-expandable="false">
									<div class="title-wrapper">
										<h3 class="title-content">Works &amp; Head Office</h3>
									</div>
									<div class="content">
										<p>
											<strong>Aqua Shakti Industries</strong><br />
											Vapi Timber Compound, Opp. Chandralok Tower,<br />
											Nr. D Mart, Chanod, VAPI – 396 195<br />
											Gujarat, India
										</p>
									</div>
								</div>
							</div>

							<!-- 2. Direct Engineering & Sales -->
							<div class="component-freeTextBlock component-default" xyl-view="freeTextBlock">
								<div class="accordion-item" data-expandable="false">
									<div class="title-wrapper">
										<h3 class="title-content">Direct Engineering &amp; Sales</h3>
									</div>
									<div class="content">
										<p>
											<strong>Mobile / Direct Sales:</strong><br />
											<a href="tel:+919913936995" class="sidebar-contact-link">+91 99139 36995</a> /
											<a href="tel:+919377555014" class="sidebar-contact-link">+91 93775 55014</a>
										</p>
										<p class="sidebar-contact-spaced">
											<strong>24/7 Helpline:</strong><br />
											<a href="tel:6356008944" class="sidebar-contact-link">6356008944</a>
										</p>
										<p class="sidebar-contact-spaced">
											<strong>Official Email:</strong><br />
											<a href="mailto:aquashakti99@gmail.com" class="sidebar-contact-link">aquashakti99@gmail.com</a>
										</p>
									</div>
								</div>
							</div>

							<!-- 3. Operating Hours -->
							<div class="component-freeTextBlock component-default" xyl-view="freeTextBlock">
								<div class="accordion-item" data-expandable="false">
									<div class="title-wrapper">
										<h3 class="title-content">Operating Hours</h3>
									</div>
									<div class="content">
										<p>
											Monday – Saturday: 9:00 AM – 7:30 PM<br />
											Emergency Breakdown &amp; Spares: 24/7
										</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Full-Width Horizontal Google Map Section targeting Company Factory Address -->
			<section class="contact-map-horizontal-section">
				<div class="map-horizontal-wrapper">
					<div class="map-heading-bar">
						<div class="map-title-group">
							<span class="map-badge">Direct Factory &amp; Works Location</span>
							<h2 class="map-title">Locate Aqua Shakti Industries on Map</h2>
							<p class="map-address-text">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
									<circle cx="12" cy="10" r="3"></circle>
								</svg>
								<span>Vapi Timber Compound, Opp. Chandralok Tower, Nr. D Mart, Chanod, VAPI – 396 195, Gujarat, India</span>
							</p>
						</div>
						<div class="map-btn-group">
							<a
								href="https://maps.google.com/?q=Aqua+Shakti+Industries+Vapi+Timber+Compound+Chanod+VAPI+396195+Gujarat"
								target="_blank"
								rel="noopener noreferrer"
								class="btn-open-gmaps"
							>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
								</svg>
								<span>Open in Google Maps &rarr;</span>
							</a>
						</div>
					</div>

					<div class="map-embed-frame">
						<iframe
							title="Aqua Shakti Industries Factory Google Map"
							src="https://maps.google.com/maps?q=Aqua+Shakti+Industries,+Vapi+Timber+Compound,+Opp.+Chandralok+Tower,+Chanod,+Vapi,+Gujarat+396195&t=&z=15&ie=UTF8&iwloc=&output=embed"
							width="100%"
							height="460"
							style="border:0;"
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						></iframe>
					</div>
				</div>
			</section>
		</main>

		<Footer />
		<QuoteModal />

		<style>
			/* ==========================================================================
			   XYLEM US EXACT STYLING & DESIGN TOKENS
			   Exact font family, spacing, notch-label forms, colors, sidebar, pure grid
			   ========================================================================== */

			:root {
				--xds-font-family: 'Roboto Flex', 'Noto Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
				--atlas-color-blue-digital: #0085ad;
				--atlas-color-blue-hover: #006f91;
				--atlas-color-blue-dependable: #0f3550;
				--atlas-color-text-main: #2b3035;
				--atlas-color-text-muted: #73777c;
				--atlas-color-border: #ddd;
				--atlas-color-border-field: #c8ced3;
				--atlas-color-error: #d9383a;
				--atlas-bg-light: #f2f3f4;
			}

			html, body.xylem-contact-body {
				background-color: #ffffff !important;
				color: var(--atlas-color-text-muted);
				font-family: var(--xds-font-family);
				font-size: 16px;
				line-height: 1.5;
				margin: 0;
				padding: 0;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}

			.contact-page-main {
				background-color: #ffffff;
				min-height: 70vh;
			}

			/* Container & Wrappers matching Xylem's .content-page-with-sidebar-wrapper */
			.content-page-with-sidebar-wrapper {
				width: 100%;
			}

			.content-page-with-sidebar-wrapper > .wrapper {
				max-width: 1200px;
				margin: 0 auto;
				padding: 2.25rem 1.5rem 4rem;
				min-width: 300px;
				box-sizing: border-box;
			}

			/* Title Container & H1 matching Xylem */
			.title-container {
				margin-bottom: 1.5rem;
			}

			h1.page-title {
				font-family: var(--xds-font-family);
				font-size: 2.25rem;
				line-height: 2.5rem;
				font-weight: 300;
				color: var(--atlas-color-blue-dependable);
				margin: 0 0 1.25rem;
				letter-spacing: -0.015em;
			}

			/* Pure Grid 24-Column Emulation */
			.pure-g {
				display: flex;
				flex-wrap: wrap;
				margin-left: -15px;
				margin-right: -15px;
			}

			.pure-u-1 {
				width: 100%;
				box-sizing: border-box;
