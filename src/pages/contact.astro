			}
		</style>

		<!-- ==========================================================================
		     DYNAMIC LOGIC & MARKETO-STYLE STATE BEHAVIOR
		     ========================================================================== -->
		<script is:inline>
			const STATE_DATA = {
				'India': [
					'Gujarat', 'Maharashtra', 'Delhi NCR', 'Karnataka', 'Tamil Nadu', 'Uttar Pradesh',
					'Rajasthan', 'West Bengal', 'Telangana', 'Andhra Pradesh', 'Haryana', 'Punjab',
					'Madhya Pradesh', 'Kerala', 'Bihar', 'Odisha', 'Assam', 'Goa', 'Jharkhand', 'Chhattisgarh',
					'Uttarakhand', 'Himachal Pradesh', 'Jammu & Kashmir'
				],
				'United States': [
					'Alabama', 'Alaska', 'Arizona', 'Arkansas', 'California', 'Colorado', 'Connecticut',
					'Delaware', 'District of Columbia', 'Florida', 'Georgia', 'Hawaii', 'Idaho', 'Illinois',
					'Indiana', 'Iowa', 'Kansas', 'Kentucky', 'Louisiana', 'Maine', 'Maryland', 'Massachusetts',
					'Michigan', 'Minnesota', 'Mississippi', 'Missouri', 'Montana', 'Nebraska', 'Nevada',
					'New Hampshire', 'New Jersey', 'New Mexico', 'New York', 'North Carolina', 'North Dakota',
					'Ohio', 'Oklahoma', 'Oregon', 'Pennsylvania', 'Rhode Island', 'South Carolina', 'South Dakota',
					'Tennessee', 'Texas', 'Utah', 'Vermont', 'Virginia', 'Washington', 'West Virginia',
					'Wisconsin', 'Wyoming'
				],
				'Canada': [
					'Alberta', 'British Columbia', 'Manitoba', 'New Brunswick', 'Newfoundland and Labrador',
					'Northwest Territories', 'Nova Scotia', 'Nunavut', 'Ontario', 'Prince Edward Island',
					'Quebec', 'Saskatchewan', 'Yukon Territory'
				],
				'Australia': [
					'Australian Capital Territory', 'New South Wales', 'Northern Territory', 'Queensland',
					'South Australia', 'Tasmania', 'Victoria', 'Western Australia'
				]
			};

			function handleCountryChange(country) {
				const stateSelect = document.getElementById('stateName');
				const stateLabel = document.getElementById('lblStateName');
				if (!stateSelect) return;

				stateSelect.innerHTML = '<option value="">Select...</option>';

				if (country === 'Canada') {
					if (stateLabel) stateLabel.textContent = 'Province Name';
				} else {
					if (stateLabel) stateLabel.textContent = 'State Name';
				}

				if (STATE_DATA[country]) {
					STATE_DATA[country].forEach(function (state) {
						const opt = document.createElement('option');
						opt.value = state;
						opt.textContent = state;
						stateSelect.appendChild(opt);
					});
				} else {
					const opt = document.createElement('option');
					opt.value = 'General / International Region';
					opt.textContent = 'General / International Region';
					stateSelect.appendChild(opt);
				}
			}

			// Initialize default country states to India (primary)
			handleCountryChange('India');

			function submitXylemForm() {
				const fields = [
					'FirstName',
					'LastName',
					'Email',
					'Company',
					'Phone',
					'Industry',
					'countryName',
					'stateName',
					'City',
					'Address',
					'Xylem_Brand',
					'PostalCode',
					'Title',
					'Request_Type__c',
					'americasUpcomingProject',
					'Xylem_Lead_Question'
				];

				let hasError = false;

				fields.forEach(function (id) {
					const el = document.getElementById(id);
					const err = document.getElementById('err-' + id);
					if (!el) return;

					let val = el.value.trim();
					let isValid = val.length > 0;

					if (id === 'Email' && isValid) {
						isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
					}

					if (!isValid) {
						el.classList.add('is-invalid');
						if (err) err.classList.add('visible');
						if (!hasError) {
							el.focus();
							hasError = true;
						}
					} else {
						el.classList.remove('is-invalid');
						if (err) err.classList.remove('visible');
					}
				});

				if (hasError) return;

				// Collect form values
				const fName = document.getElementById('FirstName').value.trim();
				const lName = document.getElementById('LastName').value.trim();
				const email = document.getElementById('Email').value.trim();
				const company = document.getElementById('Company').value.trim();
				const phone = document.getElementById('Phone').value.trim();
				const industry = document.getElementById('Industry').value;
				const country = document.getElementById('countryName').value;
				const state = document.getElementById('stateName').value;
				const city = document.getElementById('City').value.trim();
				const address = document.getElementById('Address').value.trim();
				const plantReq = document.getElementById('Xylem_Brand').value;
				const postalCode = document.getElementById('PostalCode').value.trim();
				const title = document.getElementById('Title').value.trim();
				const requestType = document.getElementById('Request_Type__c').value;
				const upcoming = document.getElementById('americasUpcomingProject').value;
				const question = document.getElementById('Xylem_Lead_Question').value.trim();
				const optIn = document.getElementById('GDPR_Consent__c').checked;

				// Construct WhatsApp message text
				const summaryText = encodeURIComponent(
					`*Aqua Shakti Water Treatment Inquiry*\n` +
					`-----------------------------------------\n` +
					`*Name:* ${fName} ${lName}\n` +
					`*Title:* ${title}\n` +
					`*Company:* ${company}\n` +
					`*Email:* ${email}\n` +
					`*Phone:* ${phone}\n` +
					`*Industry:* ${industry}\n` +
					`*Requirement:* ${plantReq}\n` +
					`*Request Type:* ${requestType}\n` +
					`*Upcoming Project:* ${upcoming}\n` +
					`*Location:* ${address}, ${city}, ${state}, ${country} (${postalCode})\n` +
					`*Project / Support Needs:*\n${question}\n` +
					(optIn ? `*Newsletter Opt-in:* Yes\n` : '')
				);

				const waUrl = `https://wa.me/919913936995?text=${summaryText}`;

				// Switch to Thank You screen
				const formEl = document.getElementById('xylem-rfq-form');
				const thankYouEl = document.getElementById('thank-you-view');
				const waBtn = document.getElementById('thank-you-wa-btn');

				if (formEl) formEl.style.display = 'none';
				if (thankYouEl) thankYouEl.style.display = 'block';
				if (waBtn) waBtn.href = waUrl;

				// Scroll smoothly to confirmation
				thankYouEl.scrollIntoView({ behavior: 'smooth', block: 'start' });

				// Try opening WhatsApp in new tab for direct response
				try {
					window.open(waUrl, '_blank');
				} catch (_) {}
			}

			function resetFormToStart() {
				const formEl = document.getElementById('xylem-rfq-form');
				const thankYouEl = document.getElementById('thank-you-view');
				if (formEl) {
					formEl.reset();
					formEl.style.display = 'block';
					handleCountryChange('India');
				}
				if (thankYouEl) thankYouEl.style.display = 'none';
			}

			// Clear error message upon input
			document.addEventListener('input', function (e) {
				if (e.target && e.target.classList.contains('mktoField')) {
					e.target.classList.remove('is-invalid');
					const err = document.getElementById('err-' + e.target.id);
					if (err) err.classList.remove('visible');
				}
			});

			// Offline message listener
			window.addEventListener('offline', function () {
				const offlineMsg = document.getElementById('offline-message');
				if (offlineMsg) offlineMsg.style.display = 'block';
			});
			window.addEventListener('online', function () {
				const offlineMsg = document.getElementById('offline-message');
				if (offlineMsg) offlineMsg.style.display = 'none';
			});
		</script>
	</body>
