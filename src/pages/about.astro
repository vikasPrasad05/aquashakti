		<script>
			// Interactive Consultation Form Submission Handler
			const form = document.getElementById('consultationForm') as HTMLFormElement | null;
			if (form) {
				form.addEventListener('submit', (e) => {
					e.preventDefault();
					const nameInput = document.getElementById('fullName') as HTMLInputElement;
					const phoneInput = document.getElementById('phone') as HTMLInputElement;
					const emailInput = document.getElementById('email') as HTMLInputElement;
					const companyInput = document.getElementById('companyName') as HTMLInputElement;
					const industrySelect = document.getElementById('industryType') as HTMLSelectElement;
					const reqInput = document.getElementById('requirement') as HTMLTextAreaElement;

					const name = nameInput?.value.trim() || '';
					const phone = phoneInput?.value.trim() || '';
					const email = emailInput?.value.trim() || '';
					const company = companyInput?.value.trim() || 'N/A';
					const industry = industrySelect?.value || 'Industrial';
					const req = reqInput?.value.trim() || 'Consultation inquiry from Website';

					// Format WhatsApp message to AquaShakti engineering team
					const text = `Hello AquaShakti Team,\n\nI would like to request a consultation from the Company Profile page.\n\n*Name:* ${name}\n*Phone:* +91 ${phone}\n*Email:* ${email}\n*Company:* ${company}\n*Industry:* ${industry}\n*Requirement:* ${req}`;
					const waUrl = `https://api.whatsapp.com/send?phone=918799374555&text=${encodeURIComponent(text)}`;
					
					// Open WhatsApp inquiry in new tab
					window.open(waUrl, '_blank');

					// Show confirmation message
					alert('Thank you, ' + name + '! Your consultation request has been initiated. Our engineering representative will connect with you shortly.');
					form.reset();
				});
			}
