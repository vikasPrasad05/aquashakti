			}

			.submit-btn {
				background-color: var(--as-orange);
				color: #ffffff;
				border: none;
				padding: 15px 40px;
				font-size: 16px;
				font-weight: 600;
				border-radius: 6px;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 10px;
				transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.2s ease;
				box-shadow: 0 6px 20px rgba(236, 116, 29, 0.3);
