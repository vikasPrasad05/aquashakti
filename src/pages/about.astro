---
// src/pages/about.astro
// Exact 1000% faithful replica of https://aquashakti.com/company-profile/
// Matching original structure, copy, official imagery, certifications, testimonials, metrics, and inquiry form
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import QuoteModal from '../components/QuoteModal.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Company Profile | Aquashakti Water Solution"
			description="Aquashakti Water Solution is one of the leading manufacturers & suppliers of industrial water and waste water treatment plants strategically located in Ahmedabad, Gujarat."
			image="/images/company-profile/about-page.jpg"
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="company-profile-page">
		<Header />

		<main id="content" class="site-main">
			<!-- ========================================================
			     HERO SECTION: Pure Water Solutions Powering Industries Worldwide
			     ======================================================== -->
			<section class="about-hero" id="hero">
				<div class="hero-bg-wrapper">
					<img
						src="/images/water-splash-world-map.jpg"
						alt="AquaShakti Global Water Splash World Map"
						class="hero-bg-img"
						loading="eager"
					/>
				</div>

				<div class="container hero-container">
					<div class="hero-card-content">
						<span class="hero-eyebrow">GLOBAL WATER TECHNOLOGY</span>
						<h1 class="hero-heading">Pure water solutions powering industries worldwide.</h1>
						<p class="hero-subheading">
							From heavy-duty industrial reverse osmosis to turnkey wastewater treatment, engineered for zero-breakdown reliability across 20+ countries.
						</p>
						<div class="hero-cta-wrap">
							<a href="/reverse-osmosis-system" class="btn-hero-primary">
								<span>Explore our solutions</span>
								<svg width="14" height="14" viewBox="0 0 16 18" fill="currentColor">
									<path fill-rule="evenodd" clip-rule="evenodd" d="M12.2056 9.86991H-0.0078125V7.86991H12.2046L6.58074 2.16365L8.0052 0.759766L15.3069 8.16848L15.9987 8.87043L15.3069 9.57237L8.0052 16.9811L6.58074 15.5772L12.2056 9.86991Z" />
								</svg>
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- 2. Row 1: About Intro (home-about-sec) -->
			<section class="vc_row home-about-sec">
				<div class="container">
					<div class="row-flex align-center">
						<div class="col-sm-4 image-col">
							<div class="about-img-wrap">
								<img
									src="/images/company-profile/about-page.jpg"
									alt="treatment plant"
									class="about-img"
									width="381"
									height="358"
									loading="eager"
								/>
							</div>
						</div>
						<div class="col-sm-8 text-col">
							<div class="about-heading-wrap">
								<h5 class="eyebrow-heading">Welcome To The Aquashakti Water Solution !</h5>
								<h2 class="main-heading">Manufacturer &amp; Suppliers of Industrial Water &amp; waste water Treatment Plants</h2>
								<div class="about-body-text">
									<p>
										Aquashakti Water Solution is one of the leading manufacturers of water and waste water treatment plant set sup manufacturers and suppliers. They are strategically located in Ahmedabad, the capital city of Gujarat. The company was established in 2007 and now has a proven track record of supplying high-quality products at the most reasonable rates. The company management, as well as core staff, thoroughly values the importance of considering the individual needs of customers and their projects.
									</p>
									<p>
										The company is working under the guidance and leadership of Mr Shital Patel, who has been credited with leading the organization to set new benchmarks of trading. He has the prowess to create a success of the projects the company handles due to his insight and rich experience. Under his authority, Aquashakti has rendered great outcomes and associated itself with high profile clients. Some of the other reputable clients include Dow Chemical International Pvt. Ltd, Jain Irrigation Systems and Pidilite industries LTd , Cure afiya pharmaceutical ltd ,diftech india .
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 3. Row 2: Official Certifications Gallery -->
			<section class="vc_row certificates-sec">
				<div class="container">
					<div class="cert-grid">
						<div class="cert-card">
							<a href="/images/company-profile/ISO-1.jpg" target="_blank" rel="noopener noreferrer" class="cert-link" title="Click to view ISO Certificate">
								<img
									src="/images/company-profile/ISO-1.jpg"
									alt="ISO Certificate"
									class="cert-img"
									width="594"
									height="847"
									loading="lazy"
								/>
								<div class="cert-overlay">
									<span class="cert-badge">ISO 9001:2015 Certified</span>
								</div>
							</a>
						</div>
						<div class="cert-card">
							<a href="/images/company-profile/CERTIE-01.jpg" target="_blank" rel="noopener noreferrer" class="cert-link" title="Click to view Certificate">
								<img
									src="/images/company-profile/CERTIE-01.jpg"
									alt="Certificate"
									class="cert-img"
									width="594"
									height="847"
									loading="lazy"
								/>
								<div class="cert-overlay">
									<span class="cert-badge">Official Accreditation</span>
								</div>
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- 4. Row 3: Services We Offer (home-product-sec about-quality-sec) -->
			<section class="vc_row home-product-sec about-quality-sec">
				<div class="container">
					<div class="section-title-wrap text-center">
						<h5 class="eyebrow-heading">Services We Offer</h5>
						<h2 class="section-title-light">High Quality Services Of Multiple Industries</h2>
						<p class="section-subtext-light">
							Aquashakti Are A Industry &amp; Manufacturing Services Provider Institutions. Suitable For Factory, Manufacturing, Industry, Engineering, Construction And Any Related Industry Care Field.
						</p>
					</div>

					<div class="quality-grid">
						<!-- Infrastructure Box -->
						<div class="quality-card">
							<div class="quality-icon-wrap">
								<img
									src="/images/company-profile/infrastructure.png"
									alt="Infrastructure"
									class="quality-icon"
									width="63"
									height="61"
									loading="lazy"
								/>
							</div>
							<h3 class="quality-card-title">Infrastructure</h3>
							<p class="quality-card-desc">
								The company is set up in a vast area for rendering services as per the best industry standards. There are well- organized units, which have a great collaboration with each other. There are different specialized departments for handling the process in an efficient manner. Every department is led by the corresponding specialist of the field. The company management takes care to procure the latest technology equipment and machines for all areas.
							</p>
						</div>

						<!-- Company Mission Box -->
						<div class="quality-card">
							<div class="quality-icon-wrap">
								<img
									src="/images/company-profile/company-mission.png"
									alt="Company mission"
									class="quality-icon"
									width="63"
									height="61"
									loading="lazy"
								/>
							</div>
							<h3 class="quality-card-title">Company mission</h3>
							<p class="quality-card-desc">
								The company has defined its mission as providing services which exceed customer requirements. That is why they do not hesitate to go a step further in order to render value-added services. Customers get integrated packages for meeting their fuel and water management goals.
							</p>
						</div>

						<!-- Company Vision Box -->
						<div class="quality-card">
							<div class="quality-icon-wrap">
								<img
									src="/images/company-profile/vompany-vision.png"
									alt="Company Vision"
									class="quality-icon"
									width="63"
									height="61"
									loading="lazy"
								/>
							</div>
							<h3 class="quality-card-title">Company Vision</h3>
							<p class="quality-card-desc">
								The management of the company makes sure that systems are wired to meet the needs of clients in coming times too. Thus, you get hassle-free services for innovative solutions with a complete explanation of benefits and implementation of better processes for greater profit. The company looks forward to expanding its services for a growing customer base of reputable businessmen of various industries.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- 5. Row 4: Testimonials (home-testimonial-sec) -->
			<section class="vc_row home-testimonial-sec">
				<div class="container">
					<div class="section-title-wrap text-center">
						<h2 class="main-heading">What our client says</h2>
						<p class="testimonial-sub-heading">
							Customer satisfaction is a primary goal for our company, here is what our customers feel about our products!
						</p>
					</div>

					<div class="testimonials-grid">
						<!-- Kamath Rahul -->
						<div class="testimonial-card">
							<div class="testimonial-quote-icon">
								<img src="/images/company-profile/Review-icon.jpg" alt="Review quote" width="36" height="36" />
							</div>
							<div class="testimonial-stars" aria-label="5 out of 5 stars">
								★★★★★
							</div>
							<p class="testimonial-text">
								"Aquashakti Water Solution is pioneer in manufacturing water treatment system. Their service and support is always up-to the mark. As per my experience, the staff is very professional and the firm is itself very ethical and transparent."
							</p>
							<div class="testimonial-author">
								<h4 class="author-name">Kamath Rahul</h4>
								<span class="author-role">Customer</span>
							</div>
						</div>

						<!-- Chin Yang -->
						<div class="testimonial-card">
							<div class="testimonial-quote-icon">
								<img src="/images/company-profile/Review-icon.jpg" alt="Review quote" width="36" height="36" />
							</div>
							<div class="testimonial-stars" aria-label="5 out of 5 stars">
								★★★★★
							</div>
							<p class="testimonial-text">
								"I would love to recommend Aquashakti Water Solution especially for RO Plants, they are one of the top RO Plant Manufacturers in India. Customer services is very good."
							</p>
							<div class="testimonial-author">
								<h4 class="author-name">Chin Yang</h4>
								<span class="author-role">Customer</span>
							</div>
						</div>

						<!-- John S Odell -->
						<div class="testimonial-card">
							<div class="testimonial-quote-icon">
								<img src="/images/company-profile/Review-icon.jpg" alt="Review quote" width="36" height="36" />
							</div>
							<div class="testimonial-stars" aria-label="5 out of 5 stars">
								★★★★★
							</div>
							<p class="testimonial-text">
								"Aquashakti Water Solution is very specializes in providing hi-tech reverse osmosis plants at the most affordable rates. Their excellent quality water plants prove the name itself. Their RO Plant solves all your hard water problems and many more."
							</p>
							<div class="testimonial-author">
								<h4 class="author-name">John S Odell</h4>
								<span class="author-role">Customer</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 6. Row 5: Best Service & Key Metrics (home-info-sec about-info-sec) -->
			<section class="vc_row home-info-sec about-info-sec">
				<div class="container">
					<div class="info-row-flex">
						<!-- Left column -->
						<div class="info-left-col">
							<h2 class="main-heading">Aquashakti Provide The Best Service For Sustainable Progress</h2>
							<p class="info-sub-desc">
								Aquashakti Are A Industry &amp; Manufacturing Services Provider Institutions. Suitable For Factory, Manufacturing, Industry, Engineering, Construction And Any Related Industry Care Field.
							</p>
							<div class="info-badge-feature">
								<span class="badge-icon">✓</span>
								<span>Engineered for zero-breakdown reliability &amp; compliance</span>
							</div>
						</div>

						<!-- Right column (4 Metric Cards in 2x2 grid) -->
						<div class="info-right-col">
							<div class="metrics-grid">
								<!-- Metric 1 -->
								<div class="metric-card">
									<div class="metric-icon-wrap">
										<img
											src="/images/company-profile/customer-ratring.png"
											alt="Customer rating"
											width="50"
											height="50"
											loading="lazy"
										/>
									</div>
									<div class="metric-text-wrap">
										<h3 class="metric-title">4.7 Customer rating</h3>
										<p class="metric-desc">Regular support for your organization's department.</p>
									</div>
								</div>

								<!-- Metric 2 -->
								<div class="metric-card">
									<div class="metric-icon-wrap">
										<img
											src="/images/company-profile/customer-review-.png"
											alt="Happy customers"
											width="50"
											height="50"
											loading="lazy"
										/>
									</div>
									<div class="metric-text-wrap">
										<h3 class="metric-title">500+ Happy customers</h3>
										<p class="metric-desc">people who value your brand beyond the initial purchase.</p>
									</div>
								</div>

								<!-- Metric 3 -->
								<div class="metric-card">
									<div class="metric-icon-wrap">
										<img
											src="/images/company-profile/cerified-company-copy.png"
											alt="Certified company"
											width="50"
											height="50"
											loading="lazy"
										/>
									</div>
									<div class="metric-text-wrap">
										<h3 class="metric-title">2015 Certified company</h3>
										<p class="metric-desc">Ensure the quality of organizations.</p>
									</div>
								</div>

								<!-- Metric 4 -->
								<div class="metric-card">
									<div class="metric-icon-wrap">
										<img
											src="/images/company-profile/service.png"
											alt="Working hour"
											width="50"
											height="50"
											loading="lazy"
										/>
									</div>
									<div class="metric-text-wrap">
										<h3 class="metric-title">24/7 Working hour</h3>
										<p class="metric-desc">We can monitor and support you 24/7.</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 7. Legal Information Section -->
			<section class="vc_row legal-info-sec">
				<div class="container">
					<div class="legal-card-wrap">
						<div class="legal-title-wrap">
							<span class="legal-badge">Verified Credentials</span>
							<h3 class="legal-heading">Legal &amp; Registration Information</h3>
						</div>
						<div class="legal-grid">
							<div class="legal-item">
								<span class="legal-label">GSTIN / UIN NO</span>
								<strong class="legal-value">24BAKPP2913A1Z5</strong>
							</div>
							<div class="legal-item">
								<span class="legal-label">REGISTRAR OF COMPANIES (ROC)</span>
								<strong class="legal-value">ROC Ahmedabad</strong>
							</div>
							<div class="legal-item">
								<span class="legal-label">DGFT / IE CODE</span>
								<strong class="legal-value">0812025717</strong>
							</div>
							<div class="legal-item">
								<span class="legal-label">MANUFACTURING WORKS</span>
								<strong class="legal-value">75, Panchratna Estate, Kathwada GIDC, Ahmedabad</strong>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- 8. Row 6: Book Your Free Consultation Now & Form (home-bottom-sec) -->
			<section class="vc_row home-bottom-sec bottom-sec" id="consultation">
				<div class="container">
					<!-- Top CTA Strip -->
					<div class="consultation-strip">
						<div class="strip-left">
							<h2 class="consultation-heading">
								Book Your <span class="txt-heading">Free</span> Consultation now!
							</h2>
						</div>

						<div class="strip-center">
							<a class="phone-circle" href="tel:+918799374555" aria-label="Call +91 8799374555">
								<svg class="phone-svg" viewBox="0 0 82 82" width="60" height="60" fill="currentColor">
									<path d="M64.5,78.2c1.7-1.9,3.6-3.6,5.4-5.4c2.6-2.7,2.7-5.9,0-8.6c-3.1-3.2-6.3-6.3-9.4-9.4
										c-2.6-2.6-5.8-2.6-8.4,0c-2,1.9-3.9,3.9-5.9,5.9c-0.1,0.1-0.3,0.2-0.4,0.3l-1.3,1.3c-0.4,0.2-0.7,0.2-1.2,0
										c-1.3-0.7-2.6-1.2-3.8-2c-5.7-3.6-10.5-8.2-14.7-13.4c-2.1-2.6-4-5.3-5.3-8.4c-0.2-0.5-0.2-0.9,0.1-1.3l1.3-1.3
										c0.1-0.1,0.1-0.2,0.2-0.3c0.6-0.6,1.2-1.1,1.8-1.7c1.4-1.3,2.7-2.7,4.1-4.1c2.7-2.7,2.7-5.9,0-8.6c-1.5-1.5-3.1-3.1-4.6-4.6
										c-1.6-1.6-3.2-3.2-4.8-4.8c-2.6-2.5-5.8-2.5-8.4,0c-2,1.9-3.9,3.9-5.9,5.9c-1.9,1.8-2.8,3.9-3,6.5c-0.3,4.1,0.7,8,2.1,11.8
										C5.2,43.8,9.6,50.7,15,57.1c7.2,8.6,15.9,15.4,26,20.4c4.6,2.2,9.3,3.9,14.4,4.2C58.9,81.8,62,81,64.5,78.2z"></path>
									<path d="M41.1,15.7c-0.7,0-1.5,0.1-2.2,0.4c-1.7,0.8-2.5,2.8-2,4.8c0.4,1.8,2,3,3.9,3c4.6,0.1,8.6,1.5,12,4.6
										c3.7,3.4,5.4,7.7,5.6,12.8c0,0.9,0.4,1.9,0.9,2.6c1.1,1.5,3,1.9,4.8,1.2c1.6-0.6,2.5-2,2.5-3.9c-0.1-7-2.6-12.9-7.5-18.1
										C54.1,18.4,48.1,15.8,41.1,15.7z"></path>
									<path d="M69,11.4c8.5,8.7,12.5,18.1,12.8,29.1c0.1,2.5-1.5,4.2-3.9,4.3c-2.6,0.1-4.3-1.4-4.4-4c-0.1-5.4-1.4-10.5-4-15.2
										C63.5,14.9,54.2,9.3,42,8.6c-1.4-0.1-2.6-0.2-3.6-1.3c-1.2-1.4-1.3-3-0.7-4.6c0.7-1.6,2-2.4,3.8-2.4c8,0.1,15.3,2.4,22,6.8
										C65.7,8.6,67.8,10.4,69,11.4z"></path>
								</svg>
							</a>
						</div>

						<div class="strip-right">
							<div class="contact-links">
								<a href="tel:+918799374555" class="contact-link">+91 8799374555</a>
								<a href="tel:+919558374555" class="contact-link">+91 9558374555</a>
								<a href="mailto:info@aquashakti.com" class="contact-link email-link">info@aquashakti.com</a>
							</div>
						</div>
					</div>

					<!-- Official Inquiry Form (new-enquiry-form) -->
					<div class="form-container">
						<form class="new-enquiry-form" id="consultationForm">
							<div class="form-grid">
								<!-- Full Name -->
								<div class="form-group">
									<input type="text" name="fullname" id="fullName" placeholder="Full Name *" required class="form-control" />
								</div>

								<!-- Email -->
								<div class="form-group">
									<input type="email" name="email" id="email" placeholder="Email *" required class="form-control" />
								</div>

								<!-- Country -->
								<div class="form-group">
									<select name="coutrylist" id="country" class="form-control" required>
										<option value="India" selected>India</option>
										<option value="United States">United States</option>
										<option value="United Arab Emirates">United Arab Emirates</option>
										<option value="United Kingdom">United Kingdom</option>
										<option value="Saudi Arabia">Saudi Arabia</option>
										<option value="Kenya">Kenya</option>
										<option value="Nigeria">Nigeria</option>
										<option value="Bangladesh">Bangladesh</option>
										<option value="Sri Lanka">Sri Lanka</option>
										<option value="Nepal">Nepal</option>
										<option value="Germany">Germany</option>
										<option value="Australia">Australia</option>
										<option value="Other">Other Country</option>
									</select>
								</div>

								<!-- Mobile No -->
								<div class="form-group tel-group">
									<span class="country-prefix">+91</span>
									<input type="tel" name="tel-24" id="phone" placeholder="Mobile No *" required class="form-control tel-input" />
								</div>

								<!-- Company Name -->
								<div class="form-group">
									<input type="text" name="companyname" id="companyName" placeholder="Company Name" class="form-control" />
								</div>

								<!-- Industry Type -->
								<div class="form-group">
									<select name="industrytype" id="industryType" class="form-control">
										<option value="">Select Industry Type</option>
										<option value="Manufacturing">Manufacturing</option>
										<option value="Chemical">Chemical</option>
										<option value="Pharmaceutical">Pharmaceutical</option>
										<option value="Food & Beverage">Food &amp; Beverage</option>
										<option value="Textile">Textile</option>
										<option value="Hospitality / Commercial">Hospitality / Commercial</option>
										<option value="Other">Other</option>
									</select>
								</div>

								<!-- Size of Facility -->
								<div class="form-group">
									<select name="sizeoffacility" id="sizeOfFacility" class="form-control">
										<option value="">Select Size of Facility</option>
										<option value="Small">Small (&lt; 10,000 sq ft)</option>
										<option value="Medium">Medium (10,000 - 50,000 sq ft)</option>
										<option value="Large">Large (&gt; 50,000 sq ft)</option>
									</select>
								</div>

								<!-- Daily Water Usage -->
								<div class="form-group">
									<input type="text" name="dailywaterusage" id="waterUsage" placeholder="Estimated Daily Water Usage (e.g. 5,000 LPH)" class="form-control" />
								</div>

								<!-- Project Timeline -->
								<div class="form-group full-width">
									<select name="projecttimeline" id="timeline" class="form-control">
										<option value="">Select Project Timeline</option>
										<option value="Immediate">Immediate (Within 1-2 weeks)</option>
										<option value="1-3 Months">1-3 Months</option>
										<option value="3-6 Months">3-6 Months</option>
										<option value="Over 6 Months">Over 6 Months</option>
									</select>
								</div>

								<!-- Enter Requirement -->
								<div class="form-group full-width">
