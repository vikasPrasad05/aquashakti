---
// src/components/ProductCarousel.astro
// Enterprise State-of-the-Art Water Treatment Plants Carousel
// 100% Fluid Width, Core Flagship Plants, Dynamic Stepper Counter & Smooth Magnetic Snap
interface Props {
	title?: string;
	subtitle?: string;
	showViewAllButton?: boolean;
}

const {
	title = 'State-of-the-Art Water Treatment Plants',
	subtitle = 'Engineered turnkey skids assembled with industrial-grade stainless steel, precision sensors, and premium membranes.',
	showViewAllButton = true,
} = Astro.props;

interface ProductItem {
	id: string;
	category: 'ro' | 'dm' | 'etp-stp';
	title: string;
	badge: string;
	badgeType: 'primary' | 'secondary' | 'accent';
	image: string;
	description: string;
	specs: string[];
	capacity: string;
	quoteName: string;
	href: string;
}

// 5 Core, High-Value Flagship Water Treatment Plants (Removed non-plant chemicals and niche package units)
const products: ProductItem[] = [
	{
		id: 'industrial-ro',
		category: 'ro',
		title: 'Industrial RO & Sea Water Plants',
		badge: '500 TO 50,000+ LPH',
		badgeType: 'primary',
		image: '/images/hero-plant.jpg',
		description: 'Heavy-duty reverse osmosis for high-TDS borewell water, river intake, and high-salinity seawater desalination.',
		specs: [
			'SS 304 / SS 316 structural skid framework',
			'Imported TFC 8040 polyamide membranes',
			'Multistage vertical high-pressure pump & CIP',
		],
		capacity: 'Up to 50,000 LPH',
		quoteName: 'Industrial RO & Sea Water Plant',
		href: '/products#industrial-ro',
	},
	{
		id: 'commercial-ro',
		category: 'ro',
		title: 'Commercial RO Systems',
		badge: '25 TO 1,000 LPH',
		badgeType: 'secondary',
		image: '/images/commercial-ro.jpg',
		description: 'Standardized commercial skid models for manufacturing hubs, institutions, hospitals, and hospitality properties.',
		specs: [
			'Standard models: 25, 50, 100, 250, 500, 1000 LPH',
			'Composite FRP / SS vessels with 5-micron pre-filter',
			'Dual flow rotameters & automated pressure safety cut-off',
		],
		capacity: '25 to 1,000 LPH',
		quoteName: 'Commercial RO Plant',
		href: '/products#commercial-ro',
	},
	{
		id: 'dm-plants',
		category: 'dm',
		title: 'Water Softeners & DM Plants',
		badge: 'ION EXCHANGE',
		badgeType: 'accent',
		image: '/images/dm-softener.jpg',
		description: 'Cationic and anionic ion-exchange columns delivering ultra-pure water with conductivity below 0.5 µS/cm.',
		specs: [
			'Multiport control valves & concentrated brine tank',
			'Corrosion-resistant FRP composite resin pressure vessels',
			'USP / IP grade two-bed and mixed-bed polishing columns',
		],
		capacity: '500 to 10,000 L/hr',
		quoteName: 'Water Softener / DM Plant',
		href: '/products#dm-plants',
	},
	{
		id: 'etp-plants',
		category: 'etp-stp',
		title: 'Effluent Treatment Plants (ETP)',
		badge: 'TURNKEY ZLD ETP',
		badgeType: 'primary',
		image: '/images/etp-stp-plant.jpg',
		description: 'Statutory GPCB/CPCB compliant industrial effluent treatment with clariflocculation and Zero Liquid Discharge (ZLD).',
		specs: [
			'Chemical flash mixing, flocculator & lamella clarifier',
			'Heavy-duty dewatering plate-and-frame filter press',
			'Biological aeration tanks for guaranteed BOD/COD reduction',
		],
		capacity: '10 to 500+ KLD',
		quoteName: 'Effluent Treatment Plant (ETP)',
		href: '/products#etp-plants',
	},
	{
		id: 'stp-plants',
		category: 'etp-stp',
		title: 'Sewage Treatment Plants (STP)',
		badge: 'BIOLOGICAL MBBR',
		badgeType: 'secondary',
		image: '/images/clarifier-hero-bg.jpg',
		description: 'Compact Delta PR biological sewage recycling yielding odorless, sanitized water for landscaping and flushing.',
		specs: [
			'Submerged fine-bubble aeration & high surface area media',
			'TSS < 15 mg/L and BOD < 10 mg/L guaranteed output',
			'Meets strict CPCB environment discharge mandates',
		],
		capacity: '5 to 200+ KLD',
		quoteName: 'Sewage Treatment Plant (STP)',
		href: '/products#stp-plants',
	},
];

const icons = {
	grid: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>`,
	check: `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`,
	chevronLeft: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>`,
	chevronRight: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>`,
	arrowRight: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`,
};
---

<section class="plants-carousel-section" id="plants-section" aria-labelledby="plants-heading">
	<div class="carousel-container">
		<!-- Section Header (Centered) -->
		<div class="carousel-header-center">
			<div class="pill-eyebrow">
				<span set:html={icons.grid} />
				<span>CORE MANUFACTURING LINEUP</span>
			</div>
			<h2 id="plants-heading" class="carousel-main-heading">{title}</h2>
			{subtitle && <p class="carousel-subtitle-text">{subtitle}</p>}
		</div>

		<!-- Filter Tabs & Stepper Row -->
		<div class="carousel-nav-bar">
			<!-- Filter Category Tabs -->
			<div class="carousel-filter-tabs" role="tablist" aria-label="Filter plants by category">
				<button type="button" class="tab-btn active" data-category="all" role="tab" aria-selected="true">
					<span>All Systems</span>
					<span class="tab-count">(5)</span>
				</button>
				<button type="button" class="tab-btn" data-category="ro" role="tab" aria-selected="false">
					<span>RO Systems</span>
					<span class="tab-count">(2)</span>
				</button>
				<button type="button" class="tab-btn" data-category="dm" role="tab" aria-selected="false">
					<span>DM &amp; Softeners</span>
					<span class="tab-count">(1)</span>
				</button>
				<button type="button" class="tab-btn" data-category="etp-stp" role="tab" aria-selected="false">
					<span>Wastewater &amp; ZLD</span>
					<span class="tab-count">(2)</span>
				</button>
			</div>

			<!-- Dynamic Stepper Navigation Group -->
			<div class="carousel-stepper-group">
				<div class="stepper-counter-capsule">
					<span class="stepper-tag">PLANT</span>
					<span class="stepper-index active" id="carousel-current-index">01</span>
					<span class="stepper-divider">/</span>
					<span class="stepper-total" id="carousel-total-count">05</span>
				</div>

				<div class="carousel-stepper-buttons">
					<button type="button" class="stepper-arrow-btn" id="plants-prev-btn" aria-label="Scroll to previous plant" title="Previous plant">
						<span set:html={icons.chevronLeft} />
					</button>
					<button type="button" class="stepper-arrow-btn" id="plants-next-btn" aria-label="Scroll to next plant" title="Next plant">
						<span set:html={icons.chevronRight} />
					</button>
				</div>
			</div>
		</div>

		<!-- Horizontal Smooth Carousel Track (Magnetic Scroll-Snap & 100% Fluid Width) -->
		<div class="carousel-rail-container" id="plants-rail" role="region" aria-label="Water treatment plants carousel track" tabindex="0">
			<div class="carousel-cards-track" id="plants-track">
				{products.map((item, idx) => (
					<article class="carousel-plant-card" data-category={item.category} data-index={idx}>
						<!-- Image & Status Badge -->
						<div class="card-image-box">
							<img 
								src={item.image} 
								alt={item.title} 
								class="card-img" 
								loading="lazy" 
								decoding="async" 
							/>
							<span class={`card-badge-pill badge-${item.badgeType}`}>
								{item.badge}
							</span>
							<span class="card-capacity-pill">
								{item.capacity}
							</span>
						</div>

						<!-- Card Body -->
						<div class="card-text-box">
							<h3 class="card-item-title">{item.title}</h3>
							<p class="card-item-desc">{item.description}</p>

							<ul class="card-specs-bullet-list">
								{item.specs.map((spec) => (
									<li>
										<span class="spec-check-icon" set:html={icons.check} />
										<span>{spec}</span>
									</li>
								))}
							</ul>

							<div class="card-action-buttons">
								<button 
									type="button" 
									class="btn-card-quote" 
									data-quote-trigger 
									data-plant={item.quoteName}
								>
									<span>Request Quote</span>
								</button>
								<a href={item.href} class="btn-card-specs">
									<span>Specs</span>
								</a>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>

		<!-- Bottom CTA Link -->
		{showViewAllButton && (
			<div class="carousel-view-all-row">
				<a href="/reverse-osmosis-system" class="btn-view-all-plants">
					<span>View Complete Technical Catalog</span>
					<span set:html={icons.arrowRight} />
				</a>
			</div>
		)}
	</div>
</section>

<script>
	function setupProductCarousel() {
		const rail = document.getElementById('plants-rail');
		const prevBtn = document.getElementById('plants-prev-btn') as HTMLButtonElement | null;
		const nextBtn = document.getElementById('plants-next-btn') as HTMLButtonElement | null;
		const filterTabs = document.querySelectorAll<HTMLButtonElement>('.carousel-filter-tabs .tab-btn');
		const currentIndexEl = document.getElementById('carousel-current-index');
		const totalCountEl = document.getElementById('carousel-total-count');
		const cards = Array.from(document.querySelectorAll<HTMLElement>('.carousel-plant-card'));

		if (!rail || !cards.length) return;

		const getVisibleCards = () => cards.filter((c) => c.style.display !== 'none');

		// Calculate scroll step
		const getScrollAmount = () => {
			const visible = getVisibleCards();
			if (!visible.length) return 360;
			const cardWidth = visible[0].offsetWidth;
			const gap = 24; // 1.5rem
			return cardWidth + gap;
		};

		// Update live counter (e.g. "01 / 05", "02 / 05")
		function updateCounter() {
			const visible = getVisibleCards();
			const total = visible.length;
			if (!total) {
				if (currentIndexEl) currentIndexEl.textContent = '00';
				if (totalCountEl) totalCountEl.textContent = '00';
				return;
			}

			if (totalCountEl) {
				totalCountEl.textContent = String(total).padStart(2, '0');
			}

			// Find card nearest to left edge of rail
			const railLeft = rail.scrollLeft;
			let activeIndex = 0;
			let minDistance = Infinity;

			visible.forEach((card, idx) => {
				const cardLeft = card.offsetLeft - rail.offsetLeft;
				const distance = Math.abs(cardLeft - railLeft);
				if (distance < minDistance) {
					minDistance = distance;
					activeIndex = idx;
				}
			});

			if (currentIndexEl) {
				currentIndexEl.textContent = String(activeIndex + 1).padStart(2, '0');
			}

			// Update disabled state for arrow buttons
			if (prevBtn) {
				const isAtStart = rail.scrollLeft <= 5;
				prevBtn.classList.toggle('is-disabled', isAtStart);
			}
			if (nextBtn) {
				const isAtEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 10;
				nextBtn.classList.toggle('is-disabled', isAtEnd);
			}
		}

		// Arrow button navigation
		prevBtn?.addEventListener('click', () => {
			rail.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
		});

		nextBtn?.addEventListener('click', () => {
			rail.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
		});

		// Keyboard navigation
		rail.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') {
				e.preventDefault();
				rail.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
			} else if (e.key === 'ArrowRight') {
				e.preventDefault();
				rail.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
			}
		});

		// Scroll listener for dynamic counter
		let scrollTimer: number | null = null;
		rail.addEventListener(
			'scroll',
			() => {
				if (!scrollTimer) {
					scrollTimer = window.requestAnimationFrame(() => {
						updateCounter();
						scrollTimer = null;
					});
				}
			},
			{ passive: true }
		);

		// Category filter tabs
		filterTabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const selectedCat = tab.getAttribute('data-category') || 'all';

				filterTabs.forEach((t) => {
					t.classList.remove('active');
					t.setAttribute('aria-selected', 'false');
				});
				tab.classList.add('active');
				tab.setAttribute('aria-selected', 'true');

				cards.forEach((card) => {
					const cardCat = card.getAttribute('data-category');
					if (selectedCat === 'all' || cardCat === selectedCat) {
						card.style.display = 'flex';
					} else {
						card.style.display = 'none';
					}
				});

				rail.scrollTo({ left: 0, behavior: 'smooth' });
				setTimeout(updateCounter, 100);
			});
		});

		// Initial counter update
		updateCounter();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupProductCarousel);
	} else {
		setupProductCarousel();
	}
	document.addEventListener('astro:page-load', setupProductCarousel);
</script>

<style>
	:root {
		color-scheme: light;
	}

	.plants-carousel-section {
		width: 100%;
		max-width: 100%;
		padding: clamp(3.5rem, 6vw, 5.5rem) 0;
		background: #faf8ff;
		border-top: 1px solid #e2e8f0;
		border-bottom: 1px solid #e2e8f0;
		box-sizing: border-box;
		overflow-x: hidden;
		position: relative;
	}

	.carousel-container {
		width: 100%;
		max-width: 1720px;
		margin: 0 auto;
		padding: 0 clamp(1rem, 2.5vw, 2.25rem);
		box-sizing: border-box;
	}

	.carousel-header-center {
		text-align: center;
		max-width: 840px;
		margin: 0 auto clamp(2rem, 3.5vw, 2.75rem);
	}

	.pill-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		background: #cce5ff;
		border: 1px solid #93ccff;
		color: #006194;
		font-family: 'Inter', sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.35rem 0.95rem;
		border-radius: 9999px;
		margin-bottom: 0.85rem;
	}

	.carousel-main-heading {
		font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
		font-size: clamp(1.8rem, 3.2vw, 2.45rem);
		font-weight: 800;
		color: #0f172a;
		letter-spacing: -0.03em;
		line-height: 1.2;
		margin: 0 0 0.65rem;
	}

	.carousel-subtitle-text {
		font-family: 'Inter', sans-serif;
		font-size: 0.98rem;
		line-height: 1.6;
		color: #475569;
		margin: 0 auto;
	}

	/* Navigation Bar: Filter Tabs + Counter & Steppers */
	.carousel-nav-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		margin-bottom: 1.75rem;
		flex-wrap: wrap;
	}

	.carousel-filter-tabs {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		background: #ffffff;
		padding: 0.35rem;
		border-radius: 9999px;
		border: 1px solid #cbd5e1;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
		flex-wrap: wrap;
	}

	.tab-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		background: transparent;
		border: none;
		padding: 0.45rem 1.05rem;
		border-radius: 9999px;
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: 0.84rem;
		font-weight: 650;
		color: #475569;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.tab-btn:hover {
		background: #f1f5f9;
		color: #0f172a;
	}

	.tab-btn.active {
		background: #006194;
		color: #ffffff;
		box-shadow: 0 4px 12px rgba(0, 97, 148, 0.25);
	}

	.tab-count {
		font-size: 0.72rem;
		opacity: 0.85;
	}

	/* Dynamic Stepper Group */
	.carousel-stepper-group {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.stepper-counter-capsule {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: #ffffff;
		border: 1px solid #cbd5e1;
		border-radius: 9999px;
		padding: 0.45rem 0.95rem;
		box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
	}

	.stepper-tag {
		font-family: 'Inter', sans-serif;
		font-size: 0.68rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #006194;
	}

	.stepper-index {
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: 0.92rem;
		font-weight: 800;
		color: #0f172a;
		line-height: 1;
	}

	.stepper-divider {
		color: #cbd5e1;
		font-size: 0.85rem;
		font-weight: bold;
	}

	.stepper-total {
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: 0.85rem;
		font-weight: 650;
		color: #64748b;
		line-height: 1;
	}

	.carousel-stepper-buttons {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.stepper-arrow-btn {
		width: 42px;
		height: 42px;
		border-radius: 50%;
		background: #ffffff;
		border: 1.5px solid #cbd5e1;
		color: #0f172a;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
		transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.stepper-arrow-btn:hover:not(.is-disabled) {
		color: #ffffff;
		border-color: #006194;
		background: #006194;
		transform: scale(1.08);
		box-shadow: 0 6px 16px rgba(0, 97, 148, 0.28);
	}

	.stepper-arrow-btn.is-disabled {
		opacity: 0.45;
		cursor: not-allowed;
		background: #f8fafc;
		border-color: #e2e8f0;
		color: #94a3b8;
		box-shadow: none;
		transform: none;
	}

	/* ==========================================================================
	   Rail & Cards Track: Edge-to-Edge with Magnetic Snap
	   ========================================================================== */
	.carousel-rail-container {
		width: 100%;
		overflow-x: auto;
		scroll-behavior: smooth;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
		scrollbar-color: #cbd5e1 transparent;
		padding-bottom: 1.25rem;
		margin-bottom: 1.75rem;
		-webkit-overflow-scrolling: touch;
	}

	.carousel-rail-container::-webkit-scrollbar {
		height: 6px;
	}

	.carousel-rail-container::-webkit-scrollbar-thumb {
		background: #cbd5e1;
		border-radius: 4px;
	}

	.carousel-cards-track {
		display: flex;
		gap: 1.5rem;
		width: max-content;
		padding: 0.5rem 0.25rem 1rem;
	}

	/* Individual Core Plant Card */
	.carousel-plant-card {
		width: clamp(310px, 23vw, 360px);
		flex-shrink: 0;
		background: #ffffff;
		border: 1px solid #e2e8f0;
		border-radius: 1.25rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
		scroll-snap-align: start;
		transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
		box-sizing: border-box;
	}

	.carousel-plant-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 20px 40px rgba(0, 97, 148, 0.12);
		border-color: #93ccff;
	}

	.card-image-box {
		position: relative;
		height: 220px;
		overflow: hidden;
		background: #f1f5f9;
	}

	.card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.45s ease;
	}

	.carousel-plant-card:hover .card-img {
		transform: scale(1.06);
	}

	.card-badge-pill {
		position: absolute;
		bottom: 0.85rem;
		left: 0.85rem;
		font-family: 'Inter', sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		backdrop-filter: blur(8px);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
	}

	.badge-primary {
		background: rgba(0, 97, 148, 0.94);
		color: #ffffff;
	}

	.badge-secondary {
		background: rgba(15, 23, 42, 0.9);
		color: #ffffff;
	}

	.badge-accent {
		background: rgba(2, 132, 199, 0.94);
		color: #ffffff;
	}

	.card-capacity-pill {
		position: absolute;
		top: 0.85rem;
		right: 0.85rem;
